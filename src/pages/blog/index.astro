---
import { getCollection } from 'astro:content';
import PageLayout from '../../layouts/PageLayout.astro';
import Container from '../../components/ui/Container.astro';
import Heading from '../../components/ui/Heading.astro';
import BlogPostCard from '../../components/content/BlogPostCard.astro';
import NewsletterSignup from '../../components/blog/NewsletterSignup.astro';
import { SITE } from '../../utils/site';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => new Date(b.data.publishedAt).getTime() - new Date(a.data.publishedAt).getTime());

const breadcrumbs = [
  { name: 'Home', url: SITE.url },
  { name: 'Blog', url: `${SITE.url}/blog/` },
];
---

<PageLayout
  title="Revenue Intelligence Blog — Pricing Teardowns, PLG & Behavioral Signals"
  description="Open-source pricing teardowns, product-led growth playbooks, and behavioral signal research from the Beton team. New posts most weeks."
  canonicalPath="/blog/"
  breadcrumbs={breadcrumbs}
>
  <section class="py-14 lg:py-20">
    <Container>
      <div class="text-center mb-10 lg:mb-14">
        <Heading as="h1">Blog</Heading>
        <p class="mt-4 text-lg text-[var(--color-text-secondary)] max-w-2xl mx-auto">
          Field notes from building open-source revenue intelligence at Beton.
        </p>
        <div class="mt-6 text-left text-[var(--color-text-secondary)] max-w-2xl mx-auto space-y-3">
          <p>
            Two recurring threads: <strong>pricing teardowns</strong> of open-source tools (n8n, Plane, Langfuse, Firecrawl, Twenty, and more — how their pricing actually works and what the usage-based vs per-seat bet implies) and <strong>product-led growth</strong> dispatches — how we instrument signals from PostHog, route them to CRMs, and learn from what converts.
          </p>
          <p>
            No growth-hack listicles. Most posts are written by <a href="/about/" class="text-[var(--color-primary-600)] hover:underline">Vlad</a> as we ship, from inside the product. New posts most weeks.
          </p>
        </div>
      </div>

      {posts.length > 0 ? (
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
          {posts.map((post) => (
            <BlogPostCard post={{
              id: post.id,
              title: post.data.title,
              link: `/blog/${post.id}/`,
              pubDate: post.data.publishedAt,
              description: post.data.description,
              thumbnail: post.data.coverImage,
              author: post.data.author,
              tags: post.data.tags,
            }} />
          ))}
        </div>
      ) : (
        <p class="text-center text-[var(--color-text-tertiary)]">No posts yet. Check back soon.</p>
      )}
    </Container>
  </section>

  <!-- Newsletter signup -->
  <section class="py-14 bg-[var(--color-surface-raised)] border-t-2 border-[var(--color-border)]">
    <Container>
      <div class="max-w-xl mx-auto">
        <NewsletterSignup
          id="blog-index-newsletter"
          heading="Stay in the loop"
          description="Get new posts on revenue intelligence and behavioral signals. No spam."
        />
      </div>
    </Container>
  </section>

</PageLayout>
