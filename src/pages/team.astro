---
import { getCollection } from 'astro:content';
import PageLayout from '../layouts/PageLayout.astro';
import Container from '../components/ui/Container.astro';
import Section from '../components/ui/Section.astro';
import Heading from '../components/ui/Heading.astro';
import TeamCard from '../components/team/TeamCard.astro';
import CTASection from '../components/shared/CTASection.astro';
import { SITE } from '../utils/site';

const members = (await getCollection('team')).sort(
  (a, b) => a.data.order - b.data.order
);

const breadcrumbs = [
  { name: 'Home', url: SITE.url },
  { name: 'Team', url: `${SITE.url}/team/` },
];

const personData = members.map((m) => ({
  name: m.data.name,
  role: m.data.role,
  bio: m.data.bio,
  social: m.data.social,
}));
---

<PageLayout
  title="Meet the Team Building Beton"
  description="Meet the team behind Beton — engineers and operators building open-source revenue intelligence to help product-led companies convert more customers."
  breadcrumbs={breadcrumbs}
  personData={personData}
>
  <Section>
    <Container>
      <div class="text-center mb-12 lg:mb-16">
        <Heading as="h1">Our Team</Heading>
        <p class="mt-4 text-lg text-[var(--color-text-secondary)] max-w-2xl mx-auto">
          Building open-source revenue intelligence.
        </p>
      </div>

      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6 max-w-4xl mx-auto">
        {members.map((member) => (
          <TeamCard member={member} />
        ))}
      </div>

      <!-- Why we build it — unique founder-voice prose (readers + indexable text) -->
      <div class="max-w-3xl mx-auto mt-16 border-t border-[var(--color-border)] pt-12">
        <Heading as="h2">Why we're building Beton</Heading>
        <div class="mt-6 space-y-4 text-[var(--color-text-secondary)] leading-relaxed">
          <p>
            We kept watching product-led companies sit on PostHog data that never reached their
            sales team. The buying signal was right there in the events — a user hit the paywall,
            added a fifth seat, ran the API hard — and nobody saw it until the deal had already
            gone cold.
          </p>
          <p>
            So we built the open-source version of the pipeline most teams try to assemble
            in-house: read the product data, score the accounts, route the signal to the CRM. It's
            AGPLv3 — self-host it for free with your own LLM key, or run it on our cloud and skip
            the ops.
          </p>
          <p>
            Small team, named humans, public code. If you'd rather read how it works before you
            trust it, the source is on <a href="https://github.com/getbeton" class="underline">GitHub</a>.
          </p>
        </div>
      </div>
    </Container>
  </Section>

  <CTASection
    headline="Want to Work with Us?"
    description="We're building the future of revenue intelligence. Join our open-source community."
    secondaryCta={{ label: 'View on GitHub', href: 'https://github.com/getbeton' }}
    trackId="team-cta"
  />
</PageLayout>
