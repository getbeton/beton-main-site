---
import { getCollection } from 'astro:content';
import PageLayout from '../../../../layouts/PageLayout.astro';
import Container from '../../../../components/ui/Container.astro';
import Heading from '../../../../components/ui/Heading.astro';
import { SITE } from '../../../../utils/site';

const scenarios = (await getCollection('dryfit-scenarios')).sort((a, b) => {
  const order = (s: typeof a) => {
    if (s.data.slug === 'posthog-web') return '00';
    if (s.data.slug === 'telegram-chat') return '01';
    if (s.data.slug === 'posthog-combined-coverage') return 'zz';
    return '10' + s.data.name.toLowerCase();
  };
  return order(a).localeCompare(order(b));
});

const breadcrumbs = [
  { name: 'Home', url: SITE.url },
  { name: 'OSS Tools', url: `${SITE.url}/oss-tools/` },
  { name: 'DryFit', url: `${SITE.url}/oss-tools/dryfit/` },
  { name: 'Scenarios', url: `${SITE.url}/oss-tools/dryfit/scenarios/` },
];

const itemList = {
  name: 'DryFit Scenarios',
  items: scenarios.map((s) => ({
    name: s.data.name,
    url: `${SITE.url}/oss-tools/dryfit/scenarios/${s.data.slug}/`,
    description: s.data.description,
  })),
};

const categoryLabel: Record<string, string> = {
  baseline: 'Baseline',
  communication: 'Chat / messaging',
  'per-seat': 'Per-seat',
  metered: 'Usage-based',
  volume: 'Transaction',
  capacity: 'Storage',
  'record-count': 'Record-based',
  tiered: 'Feature-gated',
  marketplace: 'Marketplace',
  'take-rate': 'Revenue-share',
  credit: 'Credits',
  hybrid: 'Hybrid',
  freemium: 'Freemium',
  ingest: 'Event-volume',
  combined: 'All-models',
  generic: 'Other',
};
---

<PageLayout
  title="DryFit Scenarios — 15 synthetic analytics datasets"
  description="Browse the 15 bundled dryfit scenarios covering every major SaaS business model: seat-based, usage-based, marketplace, credits, freemium, and more. Each ships with ground-truth annotations for deterministic agent benchmarking."
  canonicalPath="/oss-tools/dryfit/scenarios/"
  breadcrumbs={breadcrumbs}
  itemList={itemList}
>
  <section class="py-12 lg:py-16 border-b-2 border-[var(--color-border)]">
    <Container>
      <div class="max-w-3xl">
        <nav class="text-xs text-[var(--color-text-tertiary)] mb-6 flex flex-wrap gap-1">
          <a href="/oss-tools/dryfit/" class="hover:text-[var(--color-primary-600)] hover:underline">DryFit</a>
          <span aria-hidden="true">/</span>
          <span class="text-[var(--color-text-secondary)]">Scenarios</span>
        </nav>

        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-[family-name:var(--font-heading)] tracking-wide leading-[1.1] mb-4">
          DryFit scenarios
        </h1>
        <p class="text-lg text-[var(--color-text-secondary)] leading-relaxed max-w-2xl">
          Each scenario is a complete YAML config — success event, positive and negative signal paths, scale parameters, noise probabilities. Pick one, run the generator, get a PostgreSQL dataset plus ground_truth.json ready to grade any detector output.
        </p>
        <div class="mt-4 text-sm text-[var(--color-text-secondary)]">
          <strong>{scenarios.length}</strong> scenarios · {scenarios.reduce((sum, s) => sum + s.data.positiveSignals.length + s.data.negativeSignals.length, 0)} distinct signal paths · all MIT licensed.
        </div>
      </div>
    </Container>
  </section>

  <section class="py-12 lg:py-16">
    <Container>
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-4 max-w-6xl mx-auto">
        {scenarios.map((s) => (
          <a
            href={`/oss-tools/dryfit/scenarios/${s.data.slug}/`}
            class="group flex flex-col border-2 border-[var(--color-text)] bg-[var(--color-surface)] shadow-[var(--shadow-card)] hover:shadow-[6px_6px_0_var(--color-text)] hover:-translate-x-0.5 hover:-translate-y-0.5 transition-all p-5"
          >
            <div class="flex items-center justify-between mb-3">
              <span class="inline-flex items-center px-2 py-0.5 text-[10px] font-bold uppercase tracking-wider border border-[var(--color-border)] bg-[var(--color-surface-raised)]">
                {categoryLabel[s.data.useCaseKind] || s.data.useCaseKind}
              </span>
              <span class="text-[10px] font-[family-name:var(--font-mono)] text-[var(--color-text-tertiary)]">
                {s.data.scale.accounts.toLocaleString()} accounts
              </span>
            </div>
            <h2 class="text-base font-semibold mb-1 group-hover:text-[var(--color-primary-600)]">
              {s.data.name}
            </h2>
            <p class="text-xs text-[var(--color-text-tertiary)] mb-3 font-[family-name:var(--font-mono)]">
              → {s.data.successEvent}
            </p>
            <p class="text-sm text-[var(--color-text-secondary)] leading-relaxed mb-3 line-clamp-3">
              {s.data.valueMetric}
            </p>
            <div class="mt-auto flex items-center gap-3 text-[10px] text-[var(--color-text-tertiary)] font-[family-name:var(--font-mono)]">
              <span>+{s.data.positiveSignals.length} positive</span>
              <span>−{s.data.negativeSignals.length} negative</span>
              <span>{s.data.scale.durationDays}d</span>
            </div>
          </a>
        ))}
      </div>
    </Container>
  </section>

  <!-- Back to dryfit CTA -->
  <section class="py-10 lg:py-14 bg-[var(--color-surface-raised)] border-t-2 border-[var(--color-border)]">
    <Container>
      <div class="max-w-2xl mx-auto text-center">
        <h2 class="text-xl sm:text-2xl font-[family-name:var(--font-heading)] tracking-wide mb-4">
          Not sure which scenario to start with?
        </h2>
        <p class="text-[var(--color-text-secondary)] mb-6">
          The PostHog Web baseline is the simplest. The combined-coverage scenario exercises every event type across every business model — good for stress-testing agents that need to generalize.
        </p>
        <a href="/oss-tools/dryfit/" class="inline-flex items-center gap-2 px-5 py-3 text-sm font-bold uppercase tracking-wider border-2 border-[var(--color-text)] hover:bg-[var(--color-text)] hover:text-[var(--color-surface)]">
          ← Back to DryFit overview
        </a>
      </div>
    </Container>
  </section>
</PageLayout>
