---
import { getCollection } from 'astro:content';
import PageLayout from '../../../../layouts/PageLayout.astro';
import Container from '../../../../components/ui/Container.astro';
import Section from '../../../../components/ui/Section.astro';
import Heading from '../../../../components/ui/Heading.astro';
import { SITE } from '../../../../utils/site';

export async function getStaticPaths() {
  const scenarios = await getCollection('dryfit-scenarios');
  return scenarios.map((s) => ({
    params: { slug: s.data.slug },
    props: { scenario: s },
  }));
}

const { scenario } = Astro.props;
const d = scenario.data;

const allScenarios = await getCollection('dryfit-scenarios');
const related = allScenarios
  .filter((s) => s.data.slug !== d.slug)
  .slice(0, 4);

const breadcrumbs = [
  { name: 'Home', url: SITE.url },
  { name: 'Tools', url: `${SITE.url}/tools/` },
  { name: 'DryFit', url: `${SITE.url}/oss-tools/dryfit/` },
  { name: 'Scenarios', url: `${SITE.url}/oss-tools/dryfit/scenarios/` },
  { name: d.name, url: `${SITE.url}/oss-tools/dryfit/scenarios/${d.slug}/` },
];

const metaTitle = `${d.name} — dryfit scenario`;
const metaDescription = `${d.description} Success event: ${d.successEvent}. ${d.scale.accounts.toLocaleString()} accounts, ${d.scale.durationDays} days. MIT licensed.`;

const quickstart = `# Dockerized Postgres (recommended for inspection)
docker compose up -d

uv run dryfit \\
  -c ${d.configFile} \\
  --dsn postgresql://dryfit_writer:dryfit_writer@127.0.0.1:54329/dryfit \\
  --print-summary

# Or local Postgres
./scripts/generate-local -c ${d.configFile} --print-summary`;

const faqData = [
  {
    question: `What does the ${d.name} scenario generate?`,
    answer: `${d.description} Each run produces a PostgreSQL events table plus ground_truth.json referencing the specific event_ids that make up every positive and negative signal path.`,
  },
  {
    question: `What is the success event in this scenario?`,
    answer: `${d.successEvent}. Positive signal paths end in this event; negative paths do not. Entity type is ${d.successEntityType}.`,
  },
  {
    question: `How much data does this scenario generate?`,
    answer: `Default scale is ${d.scale.accounts.toLocaleString()} accounts, ${d.scale.usersPerAccountMean} users per account on average, ${d.scale.sessionsPerUserMean} sessions per user, spread over ${d.scale.durationDays} days. Override any value in the config YAML.`,
  },
];

// Dataset schema feeds Google Dataset Search. Each scenario is a synthetic
// PostgreSQL events table + ground_truth.json — structurally a dataset.
// Variables measured = the union of event names along positive/negative
// signal paths plus the success event.
const datasetVariables = Array.from(
  new Set([
    ...d.positiveSignals.flatMap((s) => s.path),
    ...d.negativeSignals.flatMap((s) => s.path),
    d.successEvent,
  ]),
);
const datasetData = {
  name: `${d.name} — dryfit synthetic events dataset`,
  description: `${d.description} Includes ${d.positiveSignals.length} positive and ${d.negativeSignals.length} negative signal paths against the ${d.successEvent} success event.`,
  keywords: [
    'synthetic data',
    'product analytics',
    'PostHog',
    d.scenarioKind,
    d.useCaseKind,
    'PLG signal detection',
    'agent evaluation',
  ],
  license: 'https://opensource.org/licenses/MIT',
  variableMeasured: datasetVariables,
};
---

<PageLayout
  title={metaTitle}
  description={metaDescription}
  canonicalPath={`/oss-tools/dryfit/scenarios/${d.slug}/`}
  breadcrumbs={breadcrumbs}
  faqData={faqData}
  datasetData={datasetData}
>
  <!-- Hero -->
  <section class="py-12 lg:py-16 border-b-2 border-[var(--color-border)]">
    <Container>
      <div class="max-w-4xl">
        <nav class="text-xs text-[var(--color-text-tertiary)] mb-6 flex flex-wrap gap-1">
          <a href="/oss-tools/dryfit/" class="hover:text-[var(--color-primary-600)] hover:underline">DryFit</a>
          <span aria-hidden="true">/</span>
          <a href="/oss-tools/dryfit/scenarios/" class="hover:text-[var(--color-primary-600)] hover:underline">Scenarios</a>
          <span aria-hidden="true">/</span>
          <span class="text-[var(--color-text-secondary)]">{d.name}</span>
        </nav>

        <div class="flex flex-wrap items-center gap-2 mb-4">
          <span class="inline-flex items-center px-2.5 py-1 text-xs font-bold uppercase tracking-wider border-2 border-[var(--color-text)] bg-[var(--color-surface-raised)]">
            {d.scenarioKind}
          </span>
          <span class="inline-flex items-center px-2.5 py-1 text-xs font-medium font-[family-name:var(--font-mono)] border border-[var(--color-border)] text-[var(--color-text-secondary)]">
            {d.datasetId}
          </span>
        </div>

        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-[family-name:var(--font-heading)] tracking-wide leading-[1.1] mb-4">
          {d.name}
        </h1>
        <p class="text-lg text-[var(--color-text-secondary)] leading-relaxed max-w-3xl">
          {d.description}
        </p>
      </div>
    </Container>
  </section>

  <!-- Key facts grid -->
  <Section>
    <Container>
      <div class="grid md:grid-cols-2 gap-6 max-w-5xl mx-auto">
        <div class="border-2 border-[var(--color-border)] p-6">
          <h2 class="text-sm font-bold uppercase tracking-wider text-[var(--color-text-tertiary)] mb-3">Value metric</h2>
          <p class="text-lg text-[var(--color-text)]">{d.valueMetric}</p>
        </div>
        <div class="border-2 border-[var(--color-border)] p-6">
          <h2 class="text-sm font-bold uppercase tracking-wider text-[var(--color-text-tertiary)] mb-3">Success event</h2>
          <p class="text-lg font-[family-name:var(--font-mono)] text-[var(--color-text)]">{d.successEvent}</p>
          <p class="text-xs text-[var(--color-text-tertiary)] mt-1">entity_type: {d.successEntityType}</p>
        </div>
        <div class="border-2 border-[var(--color-border)] p-6">
          <h2 class="text-sm font-bold uppercase tracking-wider text-[var(--color-text-tertiary)] mb-3">Scale</h2>
          <ul class="text-sm space-y-1">
            <li><strong>{d.scale.accounts.toLocaleString()}</strong> accounts</li>
            <li><strong>{d.scale.usersPerAccountMean}</strong> users/account (mean)</li>
            <li><strong>{d.scale.sessionsPerUserMean}</strong> sessions/user (mean)</li>
            <li><strong>{d.scale.durationDays}</strong> days of history</li>
          </ul>
        </div>
        <div class="border-2 border-[var(--color-border)] p-6">
          <h2 class="text-sm font-bold uppercase tracking-wider text-[var(--color-text-tertiary)] mb-3">Research metrics proxied</h2>
          <ul class="text-sm space-y-1">
            {d.researchMetrics.map((m) => (
              <li>— {m}</li>
            ))}
          </ul>
        </div>
      </div>
    </Container>
  </Section>

  <!-- Signals -->
  <Section class="bg-[var(--color-surface-accent-primary)] border-y-2 border-[var(--color-border)]">
    <Container>
      <div class="max-w-5xl mx-auto">
        <div class="text-center mb-10">
          <Heading as="h2">Signal paths</Heading>
          <p class="mt-4 text-[var(--color-text-secondary)] max-w-2xl mx-auto">
            Positive paths end in <code class="font-[family-name:var(--font-mono)] text-sm px-1.5 py-0.5 bg-[var(--color-surface)] border border-[var(--color-border)]">{d.successEvent}</code>. Negative paths do not. Every generated event_id belonging to a path is recorded in ground_truth.json.
          </p>
        </div>

        <div class="grid md:grid-cols-2 gap-6">
          <!-- Positive -->
          <div>
            <h3 class="text-base font-semibold mb-4 flex items-center gap-2">
              <span class="inline-block w-2 h-2 rounded-full bg-[var(--color-accent-500)]"></span>
              Positive signals ({d.positiveSignals.length})
            </h3>
            <div class="space-y-3">
              {d.positiveSignals.map((s) => (
                <div class="border-2 border-[var(--color-border)] bg-[var(--color-surface)] p-4">
                  <div class="flex items-start justify-between gap-2 mb-2">
                    <code class="text-xs font-[family-name:var(--font-mono)] text-[var(--color-text-secondary)]">{s.id}</code>
                    <span class="text-[10px] font-[family-name:var(--font-mono)] text-[var(--color-text-tertiary)] whitespace-nowrap">×{s.count}</span>
                  </div>
                  <div class="flex flex-wrap items-center gap-1.5 mb-2">
                    {s.path.map((step, i) => (
                      <>
                        <code class="text-xs font-[family-name:var(--font-mono)] px-1.5 py-0.5 bg-[var(--color-surface-raised)] border border-[var(--color-border)]">{step}</code>
                        {i < s.path.length - 1 && <span class="text-[var(--color-text-tertiary)]">→</span>}
                      </>
                    ))}
                  </div>
                  {s.cohortFilters.length > 0 && (
                    <div class="text-[10px] text-[var(--color-text-tertiary)] font-[family-name:var(--font-mono)]">
                      cohorts: {s.cohortFilters.join(', ')}
                    </div>
                  )}
                </div>
              ))}
            </div>
          </div>

          <!-- Negative -->
          <div>
            <h3 class="text-base font-semibold mb-4 flex items-center gap-2">
              <span class="inline-block w-2 h-2 rounded-full bg-[var(--color-primary-600)]"></span>
              Negative signals ({d.negativeSignals.length})
            </h3>
            <div class="space-y-3">
              {d.negativeSignals.map((s) => (
                <div class="border-2 border-[var(--color-border)] bg-[var(--color-surface)] p-4">
                  <div class="flex items-start justify-between gap-2 mb-2">
                    <code class="text-xs font-[family-name:var(--font-mono)] text-[var(--color-text-secondary)]">{s.id}</code>
                    <span class="text-[10px] font-[family-name:var(--font-mono)] text-[var(--color-text-tertiary)] whitespace-nowrap">×{s.count}</span>
                  </div>
                  <div class="flex flex-wrap items-center gap-1.5 mb-2">
                    {s.path.map((step, i) => (
                      <>
                        <code class="text-xs font-[family-name:var(--font-mono)] px-1.5 py-0.5 bg-[var(--color-surface-raised)] border border-[var(--color-border)]">{step}</code>
                        {i < s.path.length - 1 && <span class="text-[var(--color-text-tertiary)]">→</span>}
                      </>
                    ))}
                  </div>
                  {s.cohortFilters.length > 0 && (
                    <div class="text-[10px] text-[var(--color-text-tertiary)] font-[family-name:var(--font-mono)]">
                      cohorts: {s.cohortFilters.join(', ')}
                    </div>
                  )}
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </Container>
  </Section>

  <!-- Quickstart -->
  <Section>
    <Container>
      <div class="max-w-4xl mx-auto">
        <div class="text-center mb-10">
          <Heading as="h2">Generate this dataset</Heading>
          <p class="mt-4 text-[var(--color-text-secondary)]">
            Config file: <code class="font-[family-name:var(--font-mono)] text-sm px-1.5 py-0.5 bg-[var(--color-surface-raised)] border border-[var(--color-border)]">{d.configFile}</code>
          </p>
        </div>

        <div class="border-2 border-[var(--color-text)] bg-[var(--color-surface)]">
          <div class="flex items-center gap-2 px-4 py-2 border-b-2 border-[var(--color-text)] bg-[var(--color-primary-600)]">
            <span class="text-xs font-[family-name:var(--font-mono)] font-bold text-white uppercase tracking-wider">Quickstart</span>
          </div>
          <pre class="p-4 overflow-x-auto text-sm font-[family-name:var(--font-mono)] leading-relaxed text-[var(--color-text)]"><code>{quickstart}</code></pre>
        </div>

        <p class="mt-6 text-sm text-[var(--color-text-secondary)] text-center">
          Full setup instructions are in the <a href={`https://github.com/getbeton/dryfit/blob/main/${d.configFile}`} class="text-[var(--color-primary-600)] hover:underline" target="_blank" rel="noopener noreferrer">repo's README</a> — including local Postgres, Grafana inspection, and dataset restore.
        </p>
      </div>
    </Container>
  </Section>

  <!-- Noise parameters -->
  <Section class="bg-[var(--color-surface-raised)] border-y-2 border-[var(--color-border)]">
    <Container>
      <div class="max-w-4xl mx-auto">
        <div class="mb-8">
          <h2 class="text-xl sm:text-2xl font-[family-name:var(--font-heading)] tracking-wide mb-3">Noise parameters</h2>
          <p class="text-sm text-[var(--color-text-secondary)]">
            DryFit injects realistic noise on top of the generated signal paths. These probabilities are per-event. Noise never touches rows referenced by ground_truth.json — your scoring logic can trust the truth file is exact.
          </p>
        </div>

        <div class="grid sm:grid-cols-2 md:grid-cols-3 gap-3">
          {Object.entries(d.noise).map(([key, value]) => (
            <div class="border-2 border-[var(--color-border)] bg-[var(--color-surface)] p-4">
              <div class="text-xs font-[family-name:var(--font-mono)] text-[var(--color-text-tertiary)] mb-1">{key.replace(/_/g, ' ')}</div>
              <div class="text-lg font-bold font-[family-name:var(--font-mono)]">{(value * 100).toFixed(1)}%</div>
            </div>
          ))}
        </div>
      </div>
    </Container>
  </Section>

  <!-- Related scenarios -->
  <Section>
    <Container>
      <div class="max-w-5xl mx-auto">
        <h2 class="text-xl sm:text-2xl font-[family-name:var(--font-heading)] tracking-wide text-center mb-8">
          Other scenarios
        </h2>
        <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-3">
          {related.map((s) => (
            <a
              href={`/oss-tools/dryfit/scenarios/${s.data.slug}/`}
              class="group flex flex-col border-2 border-[var(--color-border)] bg-[var(--color-surface)] hover:border-[var(--color-text)] p-4"
            >
              <h3 class="text-sm font-semibold mb-1 group-hover:text-[var(--color-primary-600)]">{s.data.name}</h3>
              <p class="text-xs text-[var(--color-text-tertiary)] font-[family-name:var(--font-mono)] mb-2">→ {s.data.successEvent}</p>
              <p class="text-xs text-[var(--color-text-secondary)] line-clamp-2">{s.data.valueMetric}</p>
            </a>
          ))}
        </div>

        <div class="text-center mt-8">
          <a href="/oss-tools/dryfit/scenarios/" class="text-sm font-medium text-[var(--color-primary-600)] hover:underline">
            Browse all scenarios →
          </a>
        </div>
      </div>
    </Container>
  </Section>

  <!-- CTA -->
  <section class="py-10 lg:py-16 bg-[var(--color-primary-600)] border-y-4 border-[var(--color-text)]">
    <Container>
      <div class="text-center max-w-2xl mx-auto">
        <h2 class="text-xl sm:text-2xl font-[family-name:var(--font-heading)] tracking-wide text-white mb-4">
          Benchmark your detector against {d.name}
        </h2>
        <p class="text-white/80 mb-6 text-sm">
          Clone the repo, run the config, check your agent's output against ground_truth.json.
        </p>
        <a
          href="https://github.com/getbeton/dryfit"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center px-6 py-3 text-base font-bold uppercase tracking-wider bg-white text-[var(--color-primary-700)] border-2 border-white hover:bg-[var(--color-primary-700)] hover:text-white"
        >
          View on GitHub
        </a>
      </div>
    </Container>
  </section>
</PageLayout>
