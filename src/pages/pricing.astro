---
import { getEntry, getCollection } from 'astro:content';
import PageLayout from '../layouts/PageLayout.astro';
import Container from '../components/ui/Container.astro';
import Section from '../components/ui/Section.astro';
import Heading from '../components/ui/Heading.astro';
import PricingTable from '../components/pricing/PricingTable.astro';
import PricingComparison from '../components/pricing/PricingComparison.astro';
import AddOnCard from '../components/pricing/AddOnCard.astro';
import PricingFAQ from '../components/pricing/PricingFAQ.astro';
import CTASection from '../components/shared/CTASection.astro';
import { SITE } from '../utils/site';

const page = await getEntry('pages', 'pricing');
const addons = await getCollection('pricing-addons');
const faqItems = (await getCollection('pricing-faq')).sort((a, b) => a.data.order - b.data.order);

const faqData = faqItems.map((item) => ({
  question: item.data.question,
  answer: item.data.answer,
}));

const breadcrumbs = [
  { name: 'Home', url: SITE.url },
  { name: 'Pricing', url: `${SITE.url}/pricing/` },
];
---

<PageLayout
  title={page?.data.seo?.metaTitle || page?.data.title || 'Pricing'}
  description={page?.data.seo?.metaDescription}
  schemaType={page?.data.schemaType}
  faqData={faqData}
  breadcrumbs={breadcrumbs}
>
  <Section>
    <Container>
      <div class="text-center mb-12 lg:mb-16">
        <Heading as="h1">{page?.data.title || 'Pricing'}</Heading>
        {page?.data.subtitle && (
          <p class="mt-4 text-lg text-[var(--color-text-secondary)] max-w-2xl mx-auto">
            {page.data.subtitle}
          </p>
        )}
      </div>

      <PricingTable />
    </Container>
  </Section>

  <!-- How pricing works — unique explainer (readers + indexable text) -->
  <Section id="how-pricing-works" class="border-t border-[var(--color-border)]">
    <Container>
      <div class="max-w-3xl mx-auto">
        <Heading as="h2">How the pricing works</Heading>
        <div class="mt-6 space-y-4 text-[var(--color-text-secondary)] leading-relaxed">
          <p>
            You pay per tracked user, not per seat. A tracked user is one unique email in
            your PostHog instance that Beton watches for signals. Add ten salespeople and the
            bill doesn't move — it tracks your product's user base, not your headcount.
          </p>
          <p>
            Self-hosted is free. It's AGPLv3: clone the repo, bring your own LLM key, run it on
            your own infrastructure. No tracked-user cap, no card. What you trade is the work of
            running it yourself.
          </p>
          <p>
            Cloud is $0.50 per tracked user per month. We run the agent, ship the upgrades, and
            manage the LLM key. Connect PostHog and a CRM, and scored accounts start landing in
            seconds. Free trial, no card.
          </p>
          <p>
            Beton reads your PostHog events and routes signals to your CRM — it doesn't store a
            second copy of your product data. The bill grows with the users you track, not with a
            warehouse you have to feed.
          </p>
          <p>
            Self-host when you want full control or an air-gapped deployment. Pick cloud when
            you'd rather skip the ops and have it running in minutes. Enterprise add-ons — RBAC,
            air-gapped deployment, white-glove onboarding — sit on top of either.
          </p>
        </div>
      </div>
    </Container>
  </Section>

  <!-- Feature Comparison -->
  <Section id="compare" class="border-t border-[var(--color-border)]">
    <Container>
      <div class="text-center mb-10">
        <Heading as="h2">Compare Plans</Heading>
        <p class="mt-4 text-[var(--color-text-secondary)]">
          See exactly what's included in each plan.
        </p>
      </div>

      <div class="max-w-4xl mx-auto">
        <PricingComparison />
      </div>
    </Container>
  </Section>

  <!-- Add-ons -->
  <Section id="addons" class="border-t border-[var(--color-border)]">
    <Container>
      <div class="text-center mb-10">
        <Heading as="h2">Add-Ons</Heading>
        <p class="mt-4 text-[var(--color-text-secondary)]">
          Enterprise features available for teams with advanced needs.
        </p>
      </div>

      <div class="grid md:grid-cols-3 gap-4 max-w-4xl mx-auto">
        {addons.map((addon) => (
          <AddOnCard addon={addon.data} />
        ))}
      </div>
    </Container>
  </Section>

  <!-- FAQ -->
  <Section id="faq" class="border-t border-[var(--color-border)]">
    <Container>
      <PricingFAQ />
    </Container>
  </Section>

  <CTASection
    headline="Start Free, Scale When Ready"
    description="Free forever for self-hosted. No credit card required."
    trackId="pricing-cta"
  />
</PageLayout>
