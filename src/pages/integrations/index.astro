---
import { getCollection } from 'astro:content';
import PageLayout from '../../layouts/PageLayout.astro';
import Container from '../../components/ui/Container.astro';
import CTASection from '../../components/shared/CTASection.astro';
import { SITE } from '../../utils/site';

const integrations = await getCollection('integrations');
const live = integrations.filter((i) => !i.data.comingSoon);
const sources = live.filter((i) => i.data.category === 'source');
const destinations = live.filter((i) => i.data.category === 'destination');
const comingSoon = integrations.filter((i) => i.data.comingSoon);

const breadcrumbs = [
  { name: 'Home', url: SITE.url },
  { name: 'Integrations', url: `${SITE.url}/integrations/` },
];

const itemList = {
  name: 'Beton Integrations',
  items: live.map((integration) => ({
    name: integration.data.name,
    url: `${SITE.url}/integrations/${integration.data.slug}/`,
    description: integration.data.description,
  })),
};
---

<PageLayout
  title="Integrations — Sources & Destinations"
  description="Connect PostHog, Postgres, or Stripe as a data source. Route signals to Attio, Apollo, or any HTTPS endpoint via Webhooks. HubSpot ships next."
  canonicalPath="/integrations/"
  breadcrumbs={breadcrumbs}
  itemList={itemList}
>
  <section class="py-14 lg:py-20">
    <Container>
      <div class="max-w-3xl mx-auto text-center mb-12">
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-[family-name:var(--font-heading)] tracking-wide mb-4">
          Integrations
        </h1>
        <p class="text-lg text-[var(--color-text-secondary)] leading-relaxed">
          Connect your data source and route revenue signals to your favorite CRM and tools.
        </p>
      </div>

      <!-- Sources -->
      <div class="mb-12">
        <h2 class="text-lg font-[family-name:var(--font-heading)] tracking-wide mb-6 text-center">
          Data Sources
        </h2>
        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6 max-w-4xl mx-auto">
          {sources.map((integration) => (
            <a
              href={`/integrations/${integration.data.slug}/`}
              class="flex items-start gap-4 p-5 border-2 border-[var(--color-text)] bg-[var(--color-surface-raised)] shadow-[var(--shadow-card)] hover:shadow-[6px_6px_0_var(--color-text)] hover:-translate-x-0.5 hover:-translate-y-0.5"
            >
              <img
                src={integration.data.logo}
                alt={integration.data.name}
                width="40"
                height="40"
                class="w-10 h-10 object-contain shrink-0 logo-adaptive"
              />
              <div>
                <h3 class="font-semibold mb-1">{integration.data.name}</h3>
                <p class="text-sm text-[var(--color-text-secondary)] leading-relaxed">{integration.data.description}</p>
              </div>
            </a>
          ))}
        </div>
      </div>

      <!-- Destinations -->
      <div class="mb-12">
        <h2 class="text-lg font-[family-name:var(--font-heading)] tracking-wide mb-6 text-center">
          Destinations
        </h2>
        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6 max-w-4xl mx-auto">
          {destinations.map((integration) => (
            <a
              href={`/integrations/${integration.data.slug}/`}
              class="flex items-start gap-4 p-5 border-2 border-[var(--color-text)] bg-[var(--color-surface-raised)] shadow-[var(--shadow-card)] hover:shadow-[6px_6px_0_var(--color-text)] hover:-translate-x-0.5 hover:-translate-y-0.5"
            >
              <img
                src={integration.data.logo}
                alt={integration.data.name}
                width="40"
                height="40"
                class="w-10 h-10 object-contain shrink-0 logo-adaptive"
              />
              <div>
                <h3 class="font-semibold mb-1">{integration.data.name}</h3>
                <p class="text-sm text-[var(--color-text-secondary)] leading-relaxed">{integration.data.description}</p>
              </div>
            </a>
          ))}
        </div>
      </div>

      <!-- How connections work — unique explainer (readers + indexable text) -->
      <div class="max-w-3xl mx-auto mb-12 border-t border-[var(--color-border)] pt-12">
        <h2 class="text-lg font-[family-name:var(--font-heading)] tracking-wide mb-6 text-center">
          How Beton connects to your stack
        </h2>
        <div class="space-y-4 text-[var(--color-text-secondary)] leading-relaxed">
          <p>
            Beton sits between your data and your CRM. A <strong>source</strong> feeds it raw
            behavior — PostHog events, Postgres rows, Stripe billing. Beton scores accounts from
            that behavior and pushes the result to a <strong>destination</strong> — Attio, Apollo,
            or any endpoint over Webhooks.
          </p>
          <p>
            It reads; it doesn't move your data. Sources connect through a single read-only role,
            Beton scans on its own schedule, and it never writes back. Only the signal leaves — a
            scored account and the events behind it — routed to the destination in seconds.
          </p>
          <p>
            No native connector for your tool yet? The <a href="/integrations/webhook/" class="underline">Webhooks</a>
            destination sends the same payload to any HTTPS endpoint, so anything that accepts a
            POST already works.
          </p>
        </div>
      </div>

      {/* Coming-soon row — explicit so visitors see the roadmap and we don't
          ship a marketing claim of "supports X" for an unbuilt integration. */}
      {comingSoon.length > 0 && (
        <div>
          <h2 class="text-lg font-[family-name:var(--font-heading)] tracking-wide mb-6 text-center">
            Coming Soon
          </h2>
          <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4 max-w-4xl mx-auto">
            {comingSoon.map((integration) => (
              <a
                href={`/integrations/${integration.data.slug}/`}
                class="flex flex-col items-center gap-2 p-4 border-2 border-dashed border-[var(--color-text-secondary)] bg-[var(--color-surface)] opacity-80 hover:opacity-100"
              >
                <img
                  src={integration.data.logo}
                  alt={integration.data.name}
                  width="32"
                  height="32"
                  class="w-8 h-8 object-contain logo-adaptive"
                />
                <span class="text-sm font-medium text-[var(--color-text)]">{integration.data.name}</span>
                <span class="text-[10px] uppercase tracking-wider text-[var(--color-text-secondary)] font-bold">Roadmap</span>
              </a>
            ))}
          </div>
          <p class="text-center text-sm text-[var(--color-text-secondary)] mt-4 max-w-xl mx-auto">
            Native support is on the roadmap. Today, route signals to any of these via the <a href="/integrations/webhook/" class="underline">Webhooks integration</a>.
          </p>
        </div>
      )}
    </Container>
  </section>

  <CTASection
    headline="Connect Your Stack"
    description="Beton integrates with your existing tools to route revenue signals where they matter."
    secondaryCta={{ label: 'View on GitHub', href: 'https://github.com/getbeton' }}
    trackId="integrations-cta"
  />
</PageLayout>
