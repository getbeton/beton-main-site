---
import { getCollection } from 'astro:content';
import PageLayout from '../../layouts/PageLayout.astro';
import Container from '../../components/ui/Container.astro';
import Button from '../../components/ui/Button.astro';
import { SITE } from '../../utils/site';

export async function getStaticPaths() {
  const integrations = await getCollection('integrations');
  return integrations.map((integration) => ({
    params: { id: integration.data.slug },
    props: { entry: integration },
  }));
}

const { entry } = Astro.props;
const { name, slug, logo, url, category, description, tagline, howItWorks, features, useCases, codeSnippet, samplePayload, blogPost, faq, seo, comingSoon } = entry.data;
const noIndex = seo?.noIndex || comingSoon;

const allIntegrations = (await getCollection('integrations')).filter(
  (i) => i.data.slug !== slug
);

// Blog cluster: posts that mention this integration in their slug, title,
// or tags (case-insensitive). Builds the integration ↔ blog mesh so each
// integration page collects anchor weight from every teardown / update
// that mentions it. The single hand-picked blogPost field still drives
// the "Related update" callout above.
const slugLower = slug.toLowerCase();
const nameLower = name.toLowerCase();
const relatedBlogPosts = (await getCollection('blog', ({ data }) => !data.draft))
  .filter((p) => {
    const idLower = p.id.toLowerCase();
    const titleLower = p.data.title.toLowerCase();
    const tagsLower = (p.data.tags || []).map((t) => t.toLowerCase());
    return (
      idLower.includes(slugLower) ||
      idLower.includes(nameLower) ||
      titleLower.includes(nameLower) ||
      tagsLower.includes(slugLower) ||
      tagsLower.includes(nameLower)
    );
  })
  .sort((a, b) => new Date(b.data.publishedAt).getTime() - new Date(a.data.publishedAt).getTime())
  .slice(0, 3);

// "Pairs well with" — curate 3 complementary integrations.
// Sources pair with destinations and vice-versa. Skip coming-soon
// (they're noindex'd and linking from a real page drags quality).
const liveComplements = allIntegrations.filter(
  (i) =>
    !i.data.comingSoon &&
    i.data.category &&
    i.data.category !== entry.data.category,
);
const pairsWith = liveComplements.slice(0, 3);

// Per-pair copy: gives Google + readers a real "why these go together" sentence
// instead of a logo grid. Beats the generic "see also" pattern for both
// internal-link signal and on-page content.
const pairCopy: Record<string, string> = {
  'postgres+attio': 'Run signal discovery on your warehouse, route the high-intent accounts straight into Attio with full context.',
  'postgres+apollo': 'Score warehouse-derived buying signals, then enrich and sequence them via Apollo without a CSV in sight.',
  'postgres+webhook': 'Pipe raw warehouse-derived signals to any HTTPS endpoint — Slack, Pipedrive, Customer.io, your own service.',
  'posthog+attio': 'Convert PostHog product behaviour into Attio deals and account fields the moment a signal fires.',
  'posthog+apollo': 'Turn PostHog buying signals into Apollo sequences targeting only the accounts likely to convert.',
  'posthog+webhook': 'Stream every fired signal as JSON to wherever you already orchestrate revenue work.',
  'stripe+attio': 'Tie billing events to Attio accounts so RevOps sees expansion and downgrade risk in the same pane.',
  'stripe+apollo': 'Use revenue-side signals (upsell ready, churn risk) to prioritise Apollo outbound and renewals.',
  'stripe+webhook': 'Forward billing-derived signals to your billing analytics, finance ops, or alerting stack.',
  'firecrawl+attio': 'Auto-enrich Attio accounts with website-derived firmographic signals as soon as they show buying intent.',
  'firecrawl+apollo': 'Combine website-extracted context with Apollo personas so outbound copy actually lands.',
  'firecrawl+webhook': 'Route website-derived account context to anywhere your team already lives.',
  // destination-side fallbacks
  'attio+postgres': 'Bring warehouse-grade signals into Attio without a custom ETL.',
  'attio+posthog': 'Turn product usage into Attio account fields automatically.',
  'attio+stripe': 'Layer billing context onto Attio so renewals and expansions surface at the right moment.',
  'apollo+posthog': 'Sequence the accounts that PostHog says are ready to buy — not your full TAM.',
  'apollo+postgres': 'Run outbound on warehouse-derived buying signals instead of stale title lists.',
  'apollo+stripe': 'Align Apollo sequences to billing milestones (trial-to-paid, downgrade risk, renewal due).',
  'webhook+posthog': 'Push fired PostHog signals to any HTTPS endpoint your stack speaks.',
  'webhook+postgres': 'Forward warehouse-derived signals to any service your team already uses.',
  'webhook+firecrawl': 'Pipe website-extracted context into your existing GTM workflows.',
};

function pairBlurb(otherSlug: string) {
  return (
    pairCopy[`${slug}+${otherSlug}`] ||
    `Combine ${name} with ${otherSlug} — Beton routes signals between them automatically.`
  );
}

const breadcrumbs = [
  { name: 'Home', url: SITE.url },
  { name: 'Integrations', url: `${SITE.url}/integrations/` },
  { name: `${name} Integration`, url: `${SITE.url}/integrations/${slug}/` },
];

const faqData = (faq || []).map((item) => ({
  question: item.question,
  answer: item.answer,
}));

// HowTo schema is built from `howItWorks` setup steps. Beton's product
// surface is "connect PostHog/Stripe/etc., let signals fire, route to
// Attio" — three structured steps per integration, perfect for HowTo
// markup. The rich result for HowTo on desktop was sunset in 2023, but
// the structured data still feeds AI Overviews and LLM citations
// (which preferentially pull marked-up HowTo content for "how do I
// connect X to Y" queries).
const howToData =
  howItWorks && howItWorks.length > 0
    ? {
        name: `How to connect ${name} to Beton`,
        description: `Set up ${name} as a ${category.toLowerCase()} for Beton's revenue intelligence pipeline.`,
        steps: howItWorks.map((s) => ({ name: s.step, text: s.description })),
      }
    : undefined;
---

<PageLayout
  title={seo?.metaTitle || `${name} Integration`}
  description={seo?.metaDescription || description}
  canonicalPath={`/integrations/${slug}/`}
  noIndex={noIndex}
  breadcrumbs={breadcrumbs}
  faqData={faqData.length > 0 ? faqData : undefined}
  howToData={howToData}
>
  <!-- Hero -->
  <section class="relative py-14 lg:py-20 overflow-hidden">
    <div class="absolute inset-0 -z-10" aria-hidden="true">
      <div class="absolute -top-24 -right-24 w-96 h-96 bg-[var(--color-primary-bg-emphasis)] opacity-30 blur-3xl"></div>
      <div class="absolute -bottom-24 -left-24 w-72 h-72 bg-[var(--color-accent-bg-emphasis)] opacity-20 blur-3xl"></div>
    </div>
    <Container>
      <div class="max-w-3xl">
        <div class="flex items-center gap-4 mb-6">
          <div class="w-14 h-14 flex items-center justify-center border-2 border-[var(--color-text)] bg-[var(--color-surface-raised)] p-2.5">
            <img src={logo} alt={name} width="40" height="40" class="w-full h-full object-contain logo-adaptive" />
          </div>
          <span class="inline-flex items-center px-3 py-1 text-xs font-bold uppercase tracking-wider border-2 border-[var(--color-text)] bg-[var(--color-surface-raised)]">
            {category === 'source' ? 'Data Source' : 'Destination'}
          </span>
        </div>

        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-[family-name:var(--font-heading)] tracking-wide leading-[1.1] mb-4">
          Beton + {name}
        </h1>

        {comingSoon && (
          <div class="inline-flex items-center px-3 py-1 mb-4 text-xs font-bold uppercase tracking-wider border-2 border-[var(--color-accent-500)] bg-[var(--color-accent-bg)] text-[var(--color-accent-700)]">
            Coming soon — use Webhooks today
          </div>
        )}

        {tagline && (
          <p class="text-lg sm:text-xl text-[var(--color-text-secondary)] leading-relaxed mb-4">
            {tagline}
          </p>
        )}

        <p class="text-base text-[var(--color-text-secondary)] leading-relaxed mb-8">
          {description}
        </p>

        <div class="flex flex-col sm:flex-row gap-3">
          <Button href={SITE.external.app} size="lg" data-track-cta={`integration-${slug}-get-started`}>
            Get Started Free
          </Button>
          {url !== '#' && (
            <Button href={url} variant="outline" size="lg" target="_blank" rel="noopener noreferrer">
              Visit {name}
            </Button>
          )}
        </div>
      </div>
    </Container>
  </section>

  <!-- How it works -->
  {howItWorks && howItWorks.length > 0 && (
    <section class="py-10 lg:py-16 bg-[var(--color-surface-raised)] border-y-2 border-[var(--color-border)]">
      <Container>
        <h2 class="text-2xl sm:text-3xl font-[family-name:var(--font-heading)] tracking-wide text-center mb-10">
          How It Works
        </h2>
        <div class="grid md:grid-cols-3 gap-8 max-w-4xl mx-auto">
          {howItWorks.map((item, i) => (
            <div class="text-center">
              <div class="inline-flex items-center justify-center w-12 h-12 border-2 border-[var(--color-primary-600)] bg-[var(--color-primary-bg)] text-[var(--color-primary-600)] mb-4">
                <span class="text-lg font-bold font-[family-name:var(--font-heading)]">{i + 1}</span>
              </div>
              <h3 class="text-base font-bold mb-2">{item.step}</h3>
              <p class="text-sm text-[var(--color-text-secondary)] leading-relaxed">{item.description}</p>
            </div>
          ))}
        </div>
      </Container>
    </section>
  )}

  {/* Setup snippet — only when the integration has a real shell/SQL/code step */}
  {codeSnippet && (
    <section class="py-10 lg:py-16 bg-[var(--color-surface-raised)] border-y-2 border-[var(--color-border)]">
      <Container>
        <div class="max-w-3xl mx-auto">
          <h2 class="text-xl sm:text-2xl font-[family-name:var(--font-heading)] tracking-wide text-center mb-3">
            Setup
          </h2>
          {codeSnippet.caption && (
            <p class="text-sm text-[var(--color-text-secondary)] text-center mb-6">
              {codeSnippet.caption}
            </p>
          )}
          <div class="border-2 border-[var(--color-text)] bg-[var(--color-surface)]">
            <div class="flex items-center gap-2 px-4 py-2 border-b-2 border-[var(--color-text)] bg-[var(--color-primary-600)]">
              <span class="text-xs font-[family-name:var(--font-mono)] font-bold text-white uppercase tracking-wider">{codeSnippet.language}</span>
            </div>
            <pre class="p-4 overflow-x-auto text-sm font-[family-name:var(--font-mono)] leading-relaxed text-[var(--color-text)]"><code>{codeSnippet.content}</code></pre>
          </div>
        </div>
      </Container>
    </section>
  )}

  {/* Per-integration JSON payload — only rendered when real, integration-specific. */}
  {samplePayload && (
    <section class="py-10 lg:py-16 bg-[var(--color-surface-raised)] border-y-2 border-[var(--color-border)]">
      <Container>
        <div class="max-w-3xl mx-auto">
          <h2 class="text-xl sm:text-2xl font-[family-name:var(--font-heading)] tracking-wide text-center mb-6">
            What {name} sees
          </h2>
          <div class="border-2 border-[var(--color-text)] bg-[var(--color-surface)]">
            <div class="flex items-center gap-2 px-4 py-2 border-b-2 border-[var(--color-text)] bg-[var(--color-primary-600)]">
              <span class="text-xs font-[family-name:var(--font-mono)] font-bold text-white uppercase tracking-wider">JSON</span>
            </div>
            <pre class="p-4 overflow-x-auto text-sm font-[family-name:var(--font-mono)] leading-relaxed text-[var(--color-text)]"><code>{samplePayload}</code></pre>
          </div>
        </div>
      </Container>
    </section>
  )}

  <!-- Features & Use Cases -->
  <section class="py-10 lg:py-16">
    <Container>
      <div class="grid md:grid-cols-2 gap-10 max-w-5xl mx-auto">
        <!-- Features -->
        {features && features.length > 0 && (
          <div>
            <h2 class="text-xl sm:text-2xl font-[family-name:var(--font-heading)] tracking-wide mb-6">
              Features
            </h2>
            <ul class="space-y-3">
              {features.map((feature) => (
                <li class="flex items-start gap-3">
                  <svg class="w-5 h-5 text-[var(--color-accent-500)] shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5"></path>
                  </svg>
                  <span class="text-[var(--color-text-secondary)]">{feature}</span>
                </li>
              ))}
            </ul>
          </div>
        )}

        <!-- Use Cases -->
        {useCases && useCases.length > 0 && (
          <div>
            <h2 class="text-xl sm:text-2xl font-[family-name:var(--font-heading)] tracking-wide mb-6">
              Use Cases
            </h2>
            <ul class="space-y-3">
              {useCases.map((useCase) => (
                <li class="flex items-start gap-3">
                  <svg class="w-5 h-5 text-[var(--color-primary-500)] shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 003.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 00-3.09 3.09z"></path>
                  </svg>
                  <span class="text-[var(--color-text-secondary)]">{useCase}</span>
                </li>
              ))}
            </ul>
          </div>
        )}
      </div>
    </Container>
  </section>

  <!-- Related blog post (single hand-picked update) -->
  {blogPost && (
    <section class="py-8 lg:py-10 border-y-2 border-[var(--color-border)]">
      <Container>
        <div class="max-w-3xl mx-auto text-center">
          <p class="text-sm uppercase tracking-wider text-[var(--color-text-secondary)] mb-2 font-bold">Related update</p>
          <a href={`/blog/${blogPost}/`} class="text-lg sm:text-xl font-[family-name:var(--font-heading)] tracking-wide text-[var(--color-primary-600)] hover:underline">
            Read about how the {name} integration fits into the latest Beton release →
          </a>
        </div>
      </Container>
    </section>
  )}

  {/* Blog cluster: every post tagged with this integration. Builds the
      integration ↔ blog internal-link mesh that the SEO audit flagged
      as missing — each teardown/update gives this page anchor weight. */}
  {relatedBlogPosts.length > 0 && (
    <section class="py-10 lg:py-16 bg-[var(--color-surface-raised)] border-y-2 border-[var(--color-border)]">
      <Container>
        <div class="max-w-5xl mx-auto">
          <h2 class="text-xl sm:text-2xl font-[family-name:var(--font-heading)] tracking-wide text-center mb-3">
            From the blog
          </h2>
          <p class="text-base text-[var(--color-text-secondary)] text-center max-w-2xl mx-auto mb-10">
            Posts where {name} comes up — teardowns, integration deep-dives, release notes.
          </p>
          <div class="grid md:grid-cols-3 gap-6">
            {relatedBlogPosts.map((post) => (
              <a
                href={`/blog/${post.id}/`}
                class="group flex flex-col border-2 border-[var(--color-text)] bg-[var(--color-surface)] shadow-[var(--shadow-card)] hover:shadow-[6px_6px_0_var(--color-text)] hover:-translate-x-0.5 hover:-translate-y-0.5"
              >
                {post.data.coverImage && (
                  <div class="aspect-[16/9] border-b-2 border-[var(--color-text)] overflow-hidden">
                    <img
                      src={post.data.coverImage}
                      alt={post.data.title}
                      width="640"
                      height="360"
                      loading="lazy"
                      class="w-full h-full object-cover"
                    />
                  </div>
                )}
                <div class="p-5 flex-1 flex flex-col">
                  <time datetime={post.data.publishedAt} class="text-xs text-[var(--color-text-tertiary)] uppercase tracking-wider mb-2">
                    {new Date(post.data.publishedAt).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}
                  </time>
                  <h3 class="text-base font-semibold mb-2 group-hover:text-[var(--color-primary-600)]">
                    {post.data.title}
                  </h3>
                  <p class="text-sm text-[var(--color-text-secondary)] leading-relaxed line-clamp-3">
                    {post.data.description}
                  </p>
                </div>
              </a>
            ))}
          </div>
          <div class="text-center mt-8">
            <a
              href="/blog/"
              class="inline-flex items-center text-sm font-semibold text-[var(--color-primary-600)] hover:underline"
            >
              Read all Beton posts &rarr;
            </a>
          </div>
        </div>
      </Container>
    </section>
  )}

  <!-- FAQ -->
  {faq && faq.length > 0 && (
    <section class="py-10 lg:py-16 bg-[var(--color-surface-raised)] border-y-2 border-[var(--color-border)]">
      <Container>
        <div class="max-w-3xl mx-auto">
          <h2 class="text-2xl sm:text-3xl font-[family-name:var(--font-heading)] tracking-wide text-center mb-10">
            Frequently Asked Questions
          </h2>
          <div class="space-y-6">
            {faq.map((item) => (
              <details class="group border-2 border-[var(--color-border)] bg-[var(--color-surface)]">
                <summary class="flex items-center justify-between gap-4 cursor-pointer list-none p-5 font-semibold text-[var(--color-text)] hover:bg-[var(--color-surface-raised)]">
                  <span>{item.question}</span>
                  <svg class="w-5 h-5 shrink-0 transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5"></path>
                  </svg>
                </summary>
                <div class="px-5 pb-5 pt-0 text-[var(--color-text-secondary)] leading-relaxed">
                  {item.answer}
                </div>
              </details>
            ))}
          </div>
        </div>
      </Container>
    </section>
  )}

  <!-- CTA -->
  <section class="py-10 lg:py-16 bg-[var(--color-primary-600)] border-y-4 border-[var(--color-text)]">
    <Container>
      <div class="text-center max-w-2xl mx-auto">
        <h2 class="text-2xl sm:text-3xl font-[family-name:var(--font-heading)] tracking-wide text-white mb-4">
          {comingSoon ? `${name} is on the roadmap` : `Ready to connect ${name}?`}
        </h2>
        <p class="text-lg text-white/80 mb-8">
          {comingSoon
            ? `Native ${name} support is shipping next. In the meantime, route signals to ${name} via the generic Webhooks integration.`
            : `Start detecting revenue signals and routing them to ${name} in minutes.`}
        </p>
        <div class="flex flex-col sm:flex-row items-center justify-center gap-3">
          <a
            href={SITE.external.app}
            class="inline-flex items-center px-6 py-3 text-base font-bold uppercase tracking-wider bg-white text-[var(--color-primary-700)] border-2 border-white hover:bg-[var(--color-primary-700)] hover:text-white"
            data-track-cta={`integration-${slug}-cta`}
          >
            Get Started Free
          </a>
          <a
            href="https://github.com/getbeton"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center px-6 py-3 text-base font-bold uppercase tracking-wider text-white border-2 border-white hover:bg-white hover:text-[var(--color-primary-700)]"
          >
            <svg class="w-5 h-5 mr-1.5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"></path></svg>
            View on GitHub
          </a>
        </div>
      </div>
    </Container>
  </section>

  {/* PostHog → DryFit cross-link: surfaces the scenarios library to the
      one integration page that maps 1:1 to it. Also gives the orphan
      /oss-tools/dryfit/scenarios/* URLs an inbound link from a more-crawled page. */}
  {slug === 'posthog' && (
    <section class="py-10 lg:py-16 bg-[var(--color-surface-raised)] border-y-2 border-[var(--color-border)]">
      <Container>
        <div class="max-w-4xl mx-auto">
          <h2 class="text-xl sm:text-2xl font-[family-name:var(--font-heading)] tracking-wide text-center mb-3">
            Benchmark Beton on Your PostHog Schema
          </h2>
          <p class="text-base text-[var(--color-text-secondary)] text-center max-w-2xl mx-auto mb-8">
            DryFit ships fifteen ground-truth-annotated PostHog datasets covering every major SaaS billing model. Drop one into your test harness and benchmark the agent deterministically.
          </p>
          <div class="grid sm:grid-cols-2 gap-4">
            <a
              href="/oss-tools/dryfit/scenarios/posthog-web/"
              class="block p-5 border-2 border-[var(--color-text)] bg-[var(--color-surface)] shadow-[var(--shadow-card)] hover:shadow-[6px_6px_0_var(--color-text)] hover:-translate-x-0.5 hover:-translate-y-0.5"
            >
              <h3 class="font-semibold text-[var(--color-text)] mb-1">PostHog Web (baseline)</h3>
              <p class="text-sm text-[var(--color-text-secondary)]">
                Standard B2B SaaS web-app event stream — sessions, funnel steps, feature usage. The default dataset.
              </p>
            </a>
            <a
              href="/oss-tools/dryfit/scenarios/posthog-seat-based/"
              class="block p-5 border-2 border-[var(--color-text)] bg-[var(--color-surface)] shadow-[var(--shadow-card)] hover:shadow-[6px_6px_0_var(--color-text)] hover:-translate-x-0.5 hover:-translate-y-0.5"
            >
              <h3 class="font-semibold text-[var(--color-text)] mb-1">PostHog Seat-Based</h3>
              <p class="text-sm text-[var(--color-text-secondary)]">
                Per-seat billing pattern — invitation events, dormant seats, expansion signals. The Manychat / Acronis pattern.
              </p>
            </a>
          </div>
          <div class="text-center mt-6">
            <a
              href="/oss-tools/dryfit/scenarios/"
              class="inline-flex items-center text-sm font-semibold text-[var(--color-primary-600)] hover:underline"
            >
              Browse all 15 scenarios →
            </a>
          </div>
        </div>
      </Container>
    </section>
  )}

  {/* Pairs well with — curated complement integrations with per-pair copy.
      Replaces the old logo-grid "Other Integrations" pattern, which was
      thin signal for both Google and readers. */}
  {pairsWith.length > 0 && (
    <section class="py-10 lg:py-16">
      <Container>
        <div class="max-w-5xl mx-auto">
          <h2 class="text-xl sm:text-2xl font-[family-name:var(--font-heading)] tracking-wide text-center mb-3">
            Pairs well with
          </h2>
          <p class="text-base text-[var(--color-text-secondary)] text-center max-w-2xl mx-auto mb-10">
            {category === 'source'
              ? `${name} is the data source — pair it with a destination to actually route the signals Beton finds.`
              : `${name} is the destination — pair it with a data source so Beton has signals worth routing in the first place.`}
          </p>
          <div class="grid md:grid-cols-3 gap-6">
            {pairsWith.map((other) => (
              <a
                href={`/integrations/${other.data.slug}/`}
                class="flex flex-col p-5 border-2 border-[var(--color-text)] bg-[var(--color-surface-raised)] shadow-[var(--shadow-card)] hover:shadow-[6px_6px_0_var(--color-text)] hover:-translate-x-0.5 hover:-translate-y-0.5"
              >
                <div class="flex items-center gap-3 mb-3">
                  <img
                    src={other.data.logo}
                    alt={other.data.name}
                    width="32"
                    height="32"
                    loading="lazy"
                    class="w-8 h-8 object-contain logo-adaptive"
                  />
                  <h3 class="font-semibold text-[var(--color-text)]">{name} + {other.data.name}</h3>
                </div>
                <p class="text-sm text-[var(--color-text-secondary)] leading-relaxed">
                  {pairBlurb(other.data.slug)}
                </p>
                <span class="mt-4 text-sm font-semibold text-[var(--color-primary-600)]">
                  {other.data.name} integration →
                </span>
              </a>
            ))}
          </div>
          <div class="text-center mt-8">
            <a
              href="/integrations/"
              class="inline-flex items-center text-sm font-semibold text-[var(--color-primary-600)] hover:underline"
            >
              Browse all integrations →
            </a>
          </div>
        </div>
      </Container>
    </section>
  )}
</PageLayout>
