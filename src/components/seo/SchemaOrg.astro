---
import { SITE } from '../../utils/site';
import { buildOgImageUrl } from '../../utils/seo';

interface ReviewItem {
  name: string;
  role?: string;
  company?: string;
  quote: string;
  rating?: number;
}

interface PersonItem {
  name: string;
  role: string;
  bio?: string;
  social?: {
    twitter?: string;
    linkedin?: string;
    github?: string;
  };
}

interface ItemListItem {
  name: string;
  url?: string;
  description?: string;
}

interface ItemListSpec {
  name: string;
  items: ItemListItem[];
}

interface HowToStep {
  name: string;
  text: string;
}

interface DatasetSpec {
  name: string;
  description: string;
  keywords?: string[];
  license?: string;
  creator?: string;
  variableMeasured?: string[];
}

interface Props {
  type?: string;
  title: string;
  description: string;
  url: string;
  faqData?: { question: string; answer: string }[];
  breadcrumbs?: { name: string; url: string }[];
  reviewData?: ReviewItem[];
  personData?: PersonItem[];
  itemList?: ItemListSpec | ItemListSpec[];
  howToData?: { name: string; description: string; steps: HowToStep[] };
  datasetData?: DatasetSpec;
  profilePage?: boolean;
  speakableSelectors?: string[];
}

const {
  type,
  title,
  description,
  url,
  faqData,
  breadcrumbs,
  reviewData,
  personData,
  itemList,
  howToData,
  datasetData,
  profilePage,
  speakableSelectors,
} = Astro.props;

const orgSchema = {
  '@type': 'Organization',
  '@id': `${SITE.url}/#organization`,
  name: SITE.name,
  url: SITE.url,
  logo: `${SITE.url}/images/beton-logo.svg`,
  image: `${SITE.url}/images/beton-logo.png`,
  description: SITE.description,
  sameAs: [SITE.social.github, SITE.social.linkedin, SITE.social.twitter],
  contactPoint: {
    '@type': 'ContactPoint',
    url: `${SITE.url}/pricing/`,
    contactType: 'sales',
  },
};

const webSiteSchema = {
  '@type': 'WebSite',
  '@id': `${SITE.url}/#website`,
  name: SITE.name,
  url: SITE.url,
  description: SITE.description,
  publisher: { '@id': `${SITE.url}/#organization` },
  // Sitelinks Searchbox. Backed by /search/ which reads ?q= and filters
  // a build-time index of every public page (integrations, use-cases,
  // industries, blog posts, oss-tools, dryfit scenarios, team).
  potentialAction: {
    '@type': 'SearchAction',
    target: {
      '@type': 'EntryPoint',
      urlTemplate: `${SITE.url}/search/?q={search_term_string}`,
    },
    'query-input': 'required name=search_term_string',
  },
};

const ogImageUrl = buildOgImageUrl();

const imageSchema = {
  '@type': 'ImageObject',
  '@id': `${url.replace(/\/$/, '')}/#primaryimage`,
  url: ogImageUrl,
  contentUrl: ogImageUrl,
  width: 1200,
  height: 630,
};

// Speakable points Google Assistant (and any audio surface that respects
// the spec) at sections of the page suitable for text-to-speech playback.
// Defaults work for any content-style page: the H1 and the prose lead
// paragraph. Specific page types can override via speakableSelectors.
const speakableCss = (speakableSelectors && speakableSelectors.length > 0)
  ? speakableSelectors
  : ['h1', '.prose p:first-of-type'];

const webPageSchema = {
  '@type': 'WebPage',
  '@id': `${url.replace(/\/$/, '')}/#webpage`,
  name: title,
  description,
  url,
  isPartOf: { '@id': `${SITE.url}/#website` },
  publisher: { '@id': `${SITE.url}/#organization` },
  primaryImageOfPage: { '@id': `${url.replace(/\/$/, '')}/#primaryimage` },
  speakable: {
    '@type': 'SpeakableSpecification',
    cssSelector: speakableCss,
  },
};

// Embed verified testimonials directly on SoftwareApplication.review when
// reviewData is provided. Each Review carries its own reviewRating; itemReviewed
// is omitted because the review is nested under the item it reviews. The parent
// SoftwareApplication gets an aggregateRating computed from these ratings —
// Google requires aggregateRating whenever multiple reviews are present.
const reviewSchemas =
  reviewData && reviewData.length > 0
    ? reviewData.map((r) => ({
        '@type': 'Review',
        author: {
          '@type': 'Person',
          name: r.name,
          ...(r.role || r.company
            ? { jobTitle: [r.role, r.company].filter(Boolean).join(', ') }
            : {}),
        },
        reviewBody: r.quote,
        reviewRating: {
          '@type': 'Rating',
          ratingValue: String(r.rating ?? 5),
          bestRating: '5',
          worstRating: '1',
        },
      }))
    : null;

const aggregateRatingSchema =
  reviewData && reviewData.length > 0
    ? {
        '@type': 'AggregateRating',
        ratingValue: (
          reviewData.reduce((sum, r) => sum + (r.rating ?? 5), 0) /
          reviewData.length
        ).toFixed(1),
        reviewCount: String(reviewData.length),
        bestRating: '5',
        worstRating: '1',
      }
    : null;

const softwareSchema =
  type === 'SoftwareApplication'
    ? {
        '@type': 'SoftwareApplication',
        '@id': `${SITE.url}/#software`,
        name: SITE.name,
        applicationCategory: 'BusinessApplication',
        applicationSubCategory: 'Revenue Intelligence',
        operatingSystem: 'Web',
        description: SITE.description,
        url: SITE.url,
        publisher: { '@id': `${SITE.url}/#organization` },
        offers: [
          {
            '@type': 'Offer',
            name: 'Self-Hosted',
            price: '0',
            priceCurrency: 'USD',
            url: `${SITE.url}/pricing/`,
            availability: 'https://schema.org/InStock',
            description: 'Free self-hosted deployment with your own LLM key. GPL licensed.',
          },
          {
            '@type': 'Offer',
            name: 'Cloud',
            price: '0.50',
            priceCurrency: 'USD',
            url: `${SITE.url}/pricing/`,
            availability: 'https://schema.org/InStock',
            description: 'Per tracked user per month. Managed hosting, daily sync.',
          },
        ],
        featureList: [
          'Automated behavioral signal discovery',
          'Statistical backtest before each signal goes live',
          'CRM routing to Attio (HubSpot on roadmap)',
          'PostHog, Postgres, and Stripe data sources',
          'Apollo, Firecrawl, and Webhook destinations',
          'Self-hostable under AGPLv3',
        ],
        ...(reviewSchemas
          ? { review: reviewSchemas, aggregateRating: aggregateRatingSchema }
          : {}),
      }
    : null;

const faqSchema =
  faqData && faqData.length > 0
    ? {
        '@type': 'FAQPage',
        mainEntity: faqData.map((item) => ({
          '@type': 'Question',
          name: item.question,
          acceptedAnswer: {
            '@type': 'Answer',
            text: item.answer,
          },
        })),
      }
    : null;

const breadcrumbSchema =
  breadcrumbs && breadcrumbs.length > 0
    ? {
        '@type': 'BreadcrumbList',
        itemListElement: breadcrumbs.map((crumb, i) => ({
          '@type': 'ListItem',
          position: i + 1,
          name: crumb.name,
          item: crumb.url,
        })),
      }
    : null;

const personSchemas =
  personData && personData.length > 0
    ? personData.map((p) => ({
        '@type': 'Person',
        name: p.name,
        jobTitle: p.role,
        ...(p.bio && { description: p.bio }),
        worksFor: {
          '@type': 'Organization',
          name: SITE.name,
          url: SITE.url,
        },
        sameAs: [
          ...(p.social?.twitter ? [p.social.twitter] : []),
          ...(p.social?.linkedin ? [p.social.linkedin] : []),
          ...(p.social?.github ? [p.social.github] : []),
        ].filter(Boolean),
      }))
    : null;

// ProfilePage wrapper for /team/[id]/ — Google distinguishes
// people-as-content (a profile of a real human) from incidental Person
// markup, and ProfilePage is the explicit signal it looks for.
const profilePageSchema =
  profilePage && personSchemas && personSchemas.length === 1
    ? {
        '@type': 'ProfilePage',
        '@id': `${url.replace(/\/$/, '')}/#profilepage`,
        url,
        mainEntity: personSchemas[0],
        isPartOf: { '@id': `${SITE.url}/#website` },
      }
    : null;

// HowTo for integration setup pages. Steps come from the integration's
// `howItWorks` frontmatter array.
const howToSchema =
  howToData && howToData.steps.length > 0
    ? {
        '@type': 'HowTo',
        name: howToData.name,
        description: howToData.description,
        totalTime: 'PT10M',
        step: howToData.steps.map((s, i) => ({
          '@type': 'HowToStep',
          position: i + 1,
          name: s.name,
          text: s.text,
        })),
      }
    : null;

// Dataset for /oss-tools/dryfit/scenarios/<slug>/. Each scenario is a
// synthetic-events dataset; this is the lowest-competition rich result on
// the site (Google Dataset Search has near-zero B2B SaaS competition).
const datasetSchema = datasetData
  ? {
      '@type': 'Dataset',
      name: datasetData.name,
      description: datasetData.description,
      url,
      ...(datasetData.keywords ? { keywords: datasetData.keywords } : {}),
      ...(datasetData.license ? { license: datasetData.license } : {}),
      creator: {
        '@type': 'Organization',
        name: datasetData.creator || SITE.name,
        url: SITE.url,
      },
      ...(datasetData.variableMeasured ? { variableMeasured: datasetData.variableMeasured } : {}),
      isAccessibleForFree: true,
      includedInDataCatalog: {
        '@type': 'DataCatalog',
        name: 'dryfit synthetic-data scenarios',
        url: `${SITE.url}/oss-tools/dryfit/scenarios/`,
      },
    }
  : null;

// itemList accepts either a single list or several (the homepage emits one per
// content strip). Normalize to an array and emit one ItemList node each.
const itemListSpecs = itemList
  ? Array.isArray(itemList)
    ? itemList
    : [itemList]
  : [];
const itemListSchemas = itemListSpecs
  .filter((list) => list.items.length > 0)
  .map((list) => ({
    '@type': 'ItemList',
    name: list.name,
    numberOfItems: list.items.length,
    itemListElement: list.items.map((item, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: item.name,
      ...(item.url && { url: item.url }),
      ...(item.description && { description: item.description }),
    })),
  }));

const graph: Record<string, unknown>[] = [orgSchema, webSiteSchema, imageSchema, webPageSchema];
if (softwareSchema) graph.push(softwareSchema);
if (faqSchema) graph.push(faqSchema);
if (breadcrumbSchema) graph.push(breadcrumbSchema);
if (itemListSchemas.length > 0) graph.push(...itemListSchemas);
if (howToSchema) graph.push(howToSchema);
if (datasetSchema) graph.push(datasetSchema);
if (profilePageSchema) {
  graph.push(profilePageSchema);
} else if (personSchemas) {
  graph.push(...personSchemas);
}

const consolidatedSchema = {
  '@context': 'https://schema.org',
  '@graph': graph,
};
---

<script type="application/ld+json" set:html={JSON.stringify(consolidatedSchema)} />
