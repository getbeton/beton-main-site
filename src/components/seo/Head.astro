---
import { buildTitle, buildCanonicalUrl, buildOgImageUrl } from '../../utils/seo';
import { SITE } from '../../utils/site';
import OpenGraph from './OpenGraph.astro';
import SchemaOrg from './SchemaOrg.astro';
import GTM from '../analytics/GTM.astro';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  canonicalPath?: string;
  noIndex?: boolean;
  type?: 'website' | 'article';
  schemaType?: string;
  faqData?: { question: string; answer: string }[];
  breadcrumbs?: { name: string; url: string }[];
  reviewData?: { name: string; role?: string; company?: string; quote: string }[];
  personData?: { name: string; role: string; bio?: string; social?: { twitter?: string; linkedin?: string; github?: string } }[];
  itemList?: { name: string; items: { name: string; url: string; description?: string }[] };
  howToData?: { name: string; description: string; steps: { name: string; text: string }[] };
  datasetData?: { name: string; description: string; keywords?: string[]; license?: string; creator?: string; variableMeasured?: string[] };
  profilePage?: boolean;
  speakableSelectors?: string[];
}

const {
  title,
  description = SITE.description,
  ogImage,
  canonicalPath = Astro.url.pathname,
  noIndex = false,
  type = 'website',
  schemaType,
  faqData,
  breadcrumbs,
  reviewData,
  personData,
  itemList,
  howToData,
  datasetData,
  profilePage,
  speakableSelectors,
} = Astro.props;

const pageTitle = buildTitle(title);
const canonicalUrl = buildCanonicalUrl(canonicalPath);
const ogImageUrl = buildOgImageUrl(ogImage);

// Markdown alternate URL for AI agents and LLM scrapers. Mirrors PostHog's
// pattern: append `.md` to any URL to get a clean Markdown rendering.
// `buildCanonicalUrl` force-appends a trailing slash, which breaks `.md`
// extensions, so we build this one manually.
const markdownPath =
  canonicalPath === '/' ? '/index.md' : canonicalPath.replace(/\/$/, '.md');
const markdownUrl = `${SITE.url.replace(/\/$/, '')}${markdownPath}`;
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{pageTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonicalUrl} />

{noIndex
  ? <meta name="robots" content="noindex,nofollow" />
  : <meta name="robots" content="index,follow,max-snippet:-1,max-image-preview:large,max-video-preview:-1" />
}

<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" type="image/x-icon" href="/favicon.ico" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link rel="alternate" hreflang="en" href={canonicalUrl} />
<link rel="alternate" hreflang="x-default" href={canonicalUrl} />
{!noIndex && (
  <link rel="alternate" type="text/markdown" href={markdownUrl} title="Markdown version" />
)}

<link rel="preconnect" href="https://www.googletagmanager.com" crossorigin />
<link rel="dns-prefetch" href="https://blog.getbeton.ai" />
<link rel="dns-prefetch" href="https://inspector.getbeton.ai" />

<meta name="generator" content={Astro.generator} />
<meta name="theme-color" content="#000000" media="(prefers-color-scheme: light)" />
<meta name="theme-color" content="#0a0a0a" media="(prefers-color-scheme: dark)" />

<link rel="preload" href="/fonts/inter-var.woff2" as="font" type="font/woff2" crossorigin />
<link rel="preload" href="/fonts/cal-sans-semibold.woff2" as="font" type="font/woff2" crossorigin />

<OpenGraph
  title={pageTitle}
  description={description}
  image={ogImageUrl}
  url={canonicalUrl}
  type={type}
/>

<SchemaOrg
  type={schemaType}
  title={pageTitle}
  description={description}
  url={canonicalUrl}
  faqData={faqData}
  breadcrumbs={breadcrumbs}
  reviewData={reviewData}
  personData={personData}
  itemList={itemList}
  howToData={howToData}
  datasetData={datasetData}
  profilePage={profilePage}
  speakableSelectors={speakableSelectors}
/>

<GTM />
