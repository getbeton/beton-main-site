---
import { getCollection } from 'astro:content';
import { footerNav, socialLinks } from '../../utils/navigation';
import { SITE } from '../../utils/site';

const year = new Date().getFullYear();

const integrations = await getCollection('integrations');
const live = integrations.filter(i => !i.data.comingSoon);
const sources = live.filter(i => i.data.category === 'source');
const destinations = live.filter(i => i.data.category === 'destination');

const latestPosts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => new Date(b.data.publishedAt).getTime() - new Date(a.data.publishedAt).getTime())
  .slice(0, 4);
---

<footer class="border-t-2 border-[var(--color-text)] bg-[var(--color-surface)]">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-12 lg:py-16">
    <div class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-7 gap-8">
      <!-- Brand -->
      <div class="col-span-2 md:col-span-4 lg:col-span-2">
        <a href="/" class="inline-flex items-center gap-2.5" aria-label="Beton home">
          <svg width="24" height="29" viewBox="0 0 153 184" fill="currentColor" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <g fill-rule="evenodd">
              <path d="M 133 0 C 134.67 -0.17 139.17 -1 142 0 C 144.83 1 148.17 3.67 150 6 C 151.83 8.33 153 10.83 153 14 C 153 17.17 151.83 22 150 25 C 148.17 28 147.67 28.33 142 32 C 136.33 35.67 122.17 43.67 116 47 C 109.83 50.33 108.17 51 105 52 C 101.83 53 99 51.83 97 53 C 95 54.17 93.67 54.17 93 59 C 92.33 63.83 93.33 77.67 93 82 C 92.67 86.33 91 85 91 85 C 91 85 106.33 92.83 110 95 C 113.67 97.17 112.5 97.17 113 98 C 113.5 98.83 114 98.83 113 100 C 112 101.17 120.33 96.67 107 105 C 93.67 113.33 46 142.67 33 150 C 20 157.33 31.5 150.83 29 149 C 26.5 147.17 22.67 143.5 18 139 C 13.33 134.5 4 125.5 1 122 C -2 118.5 0 118 0 118 C 0 118 37.33 76.67 46 68 C 54.67 59.33 47.5 64.5 52 66 C 56.5 67.5 69 75.17 73 77 C 77 78.83 76 77 76 77 C 76 77 77.67 78.33 78 74 C 78.33 69.67 77.17 56.83 78 51 C 78.83 45.17 80.67 42.5 83 39 C 85.33 35.5 85 35.83 92 30 C 99 24.17 118.33 8.83 125 4 C 131.67 -0.83 130.67 1.67 132 1 C 133.33 0.33 131.33 0.17 133 0 Z"/>
              <path d="M 113 114 C 113 114 113.33 125 113 128 C 112.67 131 123.67 122.67 111 132 C 98.33 141.33 50.17 175.33 37 184 C 23.83 192.67 38 189.17 32 184 C 26 178.83 6.33 160.67 1 153 C -4.33 145.33 0 138 0 138 C 0 138 20.33 157.67 25 162 C 29.67 166.33 26.67 163.67 28 164 C 29.33 164.33 19 172.17 33 164 C 47 155.83 98.67 123.33 112 115 C 125.33 106.67 113 114 113 114 Z"/>
            </g>
          </svg>
          <span class="text-lg font-bold tracking-[-0.02em] lowercase font-[family-name:'JetBrains_Mono',ui-monospace,monospace]">beton</span>
        </a>
        <p class="mt-3 text-sm text-[var(--color-text-secondary)] max-w-xs">
          Open-source revenue intelligence. The agent proposes signal hypotheses from your PostHog or Postgres data, backtests them, and routes winners to your CRM.
        </p>
        <!-- Social links -->
        <div class="flex items-center gap-3 mt-4">
          {socialLinks.map((link) => (
            <a
              href={link.href}
              target="_blank"
              rel="noopener noreferrer"
              class="text-[var(--color-text-tertiary)] hover:text-[var(--color-text-secondary)]"
              aria-label={link.label}
            >
              {link.icon === 'github' && (
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"></path>
                </svg>
              )}
              {link.icon === 'linkedin' && (
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"></path>
                </svg>
              )}
              {link.icon === 'twitter' && (
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"></path>
                </svg>
              )}
            </a>
          ))}
        </div>
      </div>

      <!-- Company -->
      <div>
        <h3 class="text-sm font-semibold text-[var(--color-text)]">Company</h3>
        <ul class="mt-3 space-y-2">
          {footerNav.company.map((link) => (
            <li>
              <a
                href={link.href}
                target={link.external ? '_blank' : undefined}
                rel={link.external ? 'noopener noreferrer' : undefined}
                class="text-sm text-[var(--color-text-secondary)] hover:text-[var(--color-text)]"
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Tools -->
      <div>
        <h3 class="text-sm font-semibold text-[var(--color-text)]">Tools</h3>
        <ul class="mt-3 space-y-2">
          {footerNav.tools.map((link) => (
            <li>
              <a
                href={link.href}
                target={link.external ? '_blank' : undefined}
                rel={link.external ? 'noopener noreferrer' : undefined}
                class="text-sm text-[var(--color-text-secondary)] hover:text-[var(--color-text)] font-[family-name:'JetBrains_Mono']"
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Resources -->
      <div>
        <h3 class="text-sm font-semibold text-[var(--color-text)]">Resources</h3>
        <ul class="mt-3 space-y-2">
          {footerNav.resources.map((link) => (
            <li>
              <a
                href={link.href}
                target={link.external ? '_blank' : undefined}
                rel={link.external ? (link.nofollow ? 'noopener noreferrer nofollow' : 'noopener noreferrer') : undefined}
                class="text-sm text-[var(--color-text-secondary)] hover:text-[var(--color-text)]"
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Latest from the blog -->
      <div>
        <h3 class="text-sm font-semibold text-[var(--color-text)]">Latest posts</h3>
        <ul class="mt-3 space-y-2">
          {latestPosts.map((post) => (
            <li>
              <a
                href={`/blog/${post.id}/`}
                class="text-sm text-[var(--color-text-secondary)] hover:text-[var(--color-text)] line-clamp-2"
              >
                {post.data.title}
              </a>
            </li>
          ))}
          <li class="pt-1">
            <a
              href="/blog/"
              class="text-sm font-semibold text-[var(--color-primary-600)] hover:underline"
            >
              All posts &rarr;
            </a>
          </li>
        </ul>
      </div>

      <!-- Data Sources + Destinations -->
      <div>
        <h3 class="text-sm font-semibold text-[var(--color-text)]">Data Sources</h3>
        <ul class="mt-3 space-y-2">
          {sources.map((integration) => (
            <li>
              <a
                href={`/integrations/${integration.data.slug}/`}
                class="text-sm text-[var(--color-text-secondary)] hover:text-[var(--color-text)]"
              >
                {integration.data.name}
              </a>
            </li>
          ))}
        </ul>

        <h3 class="text-sm font-semibold text-[var(--color-text)] mt-6">Destinations</h3>
        <ul class="mt-3 space-y-2">
          {destinations.map((integration) => (
            <li>
              <a
                href={`/integrations/${integration.data.slug}/`}
                class="text-sm text-[var(--color-text-secondary)] hover:text-[var(--color-text)]"
              >
                {integration.data.name}
              </a>
            </li>
          ))}
        </ul>
      </div>

    </div>

    <!-- Bottom bar -->
    <div class="mt-12 pt-8 border-t-2 border-[var(--color-text)] flex flex-col sm:flex-row items-center justify-between gap-4">
      <div class="flex flex-col sm:flex-row items-center gap-2 sm:gap-4">
        <p class="text-sm text-[var(--color-text-tertiary)]">
          &copy; {year} {SITE.entity}. All rights reserved.
        </p>
        <span class="hidden sm:inline text-[var(--color-text-tertiary)]">&middot;</span>
        <a href="https://ostr.io" class="text-sm text-[var(--color-text-tertiary)] hover:text-[var(--color-text-secondary)]">
          Powered by ostr.io — SEO middleware
        </a>
      </div>
      <div class="flex items-center gap-4">
        {footerNav.legal.map((link) => (
          <a
            href={link.href}
            class="text-sm text-[var(--color-text-tertiary)] hover:text-[var(--color-text-secondary)]"
          >
            {link.label}
          </a>
        ))}
      </div>
    </div>
  </div>
</footer>
