---
import Container from '../ui/Container.astro';
import Section from '../ui/Section.astro';
import Heading from '../ui/Heading.astro';

interface Props {
  faqs: { question: string; answer: string }[];
}

const { faqs } = Astro.props;
---

{faqs.length > 0 && (
  <Section id="faq">
    <Container>
      <div class="text-center mb-10 lg:mb-14">
        <Heading as="h2">Frequently Asked Questions</Heading>
      </div>

      <div class="max-w-3xl mx-auto space-y-4">
        {faqs.map((faq) => (
          <details class="group border-2 border-[var(--color-border)] bg-[var(--color-surface-raised)] open:border-l-4 open:border-l-[var(--color-primary-500)]">
            <summary class="flex items-center justify-between cursor-pointer p-5 text-sm font-medium select-none">
              {faq.question}
              <svg
                class="w-5 h-5 text-[var(--color-text-tertiary)] transition-transform group-open:rotate-180 shrink-0 ml-4"
                fill="none"
                viewBox="0 0 24 24"
                stroke-width="1.5"
                stroke="currentColor"
              >
                <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5"></path>
              </svg>
            </summary>
            <div class="px-5 pb-5 text-sm text-[var(--color-text-secondary)] leading-relaxed">
              {faq.answer}
            </div>
          </details>
        ))}
      </div>
    </Container>
  </Section>
)}
