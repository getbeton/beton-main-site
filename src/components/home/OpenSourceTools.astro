---
import Container from '../ui/Container.astro';
import Section from '../ui/Section.astro';
import Heading from '../ui/Heading.astro';
import Card from '../ui/Card.astro';

const tools = [
  {
    name: 'dryfit',
    tagline: 'Synthetic analytics datasets for agent benchmarking',
    description:
      'Fifteen ground-truth-annotated PostHog datasets covering every major SaaS billing model — seat-based, usage-based, marketplace, credits, freemium, and more. Drop into your agent test harness and benchmark deterministically.',
    href: '/tools/dryfit/scenarios/',
    github: 'https://github.com/getbeton/dryfit',
    accentClass: 'border-t-[var(--color-accent-600)]',
    icon: 'chart-bar',
  },
  {
    name: 'seqd',
    tagline: 'Self-hosted email sequencer',
    description:
      'Per-contact email sequences, multi-mailbox Gmail OAuth, reply detection, and CC/BCC for CRM passthrough. No Instantly. No Apollo. Just your inbox.',
    href: '/seqd/',
    github: 'https://github.com/getbeton/seqd',
    accentClass: 'border-t-[var(--color-primary-500)]',
    icon: 'envelope',
  },
  {
    name: 'openclaw-gtm-skills',
    tagline: 'Company research pipeline for OpenClaw',
    description:
      'Nine AI skills that take a list of domains and turn them into researched, scored, segmented, and outreach-ready B2B prospects. A Clay alternative you self-host.',
    href: 'https://github.com/getbeton/openclaw-gtm-skills',
    github: 'https://github.com/getbeton/openclaw-gtm-skills',
    accentClass: 'border-t-[var(--color-accent-500)]',
    icon: 'magnifying-glass',
    external: true,
  },
];

const iconPaths: Record<string, string> = {
  envelope:
    'M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75',
  'magnifying-glass':
    'M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z',
  'chart-bar':
    'M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 013 19.875v-6.75zM9.75 8.625c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V8.625zM16.5 4.125c0-.621.504-1.125 1.125-1.125h2.25C20.496 3 21 3.504 21 4.125v15.75c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V4.125z',
};
---

<Section class="border-t-2 border-[var(--color-border)]">
  <Container>
    <div class="text-center mb-10 lg:mb-14">
      <Heading as="h2">More open source tools</Heading>
      <p class="mt-4 text-lg text-[var(--color-text-secondary)] max-w-2xl mx-auto">
        Built to scratch our own itch. Shared because you probably have the same itch.
      </p>
    </div>

    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6 max-w-6xl mx-auto">
      {tools.map((tool) => (
        <Card href={tool.external ? undefined : tool.href} class={`border-t-4 ${tool.accentClass}`}>
          <div class="inline-flex items-center justify-center w-10 h-10 border-2 border-[var(--color-primary-600)] bg-[var(--color-primary-bg)] text-[var(--color-primary-600)] mb-4">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d={iconPaths[tool.icon]} />
            </svg>
          </div>
          <div class="flex items-start justify-between gap-2 mb-1">
            <h3 class="text-base font-semibold font-[family-name:'JetBrains_Mono']">{tool.name}</h3>
            <span class="text-xs font-medium px-2 py-0.5 border border-[var(--color-border)] text-[var(--color-text-secondary)] whitespace-nowrap">
              AGPLv3
            </span>
          </div>
          <p class="text-xs text-[var(--color-text-tertiary)] mb-3">{tool.tagline}</p>
          <p class="text-sm text-[var(--color-text-secondary)] leading-relaxed mb-5">
            {tool.description}
          </p>
          <div class="flex items-center gap-3 mt-auto">
            {!tool.external && (
              <a
                href={tool.href}
                class="text-sm font-semibold text-[var(--color-primary-600)] hover:underline"
              >
                Learn more →
              </a>
            )}
            <a
              href={tool.github}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 text-sm text-[var(--color-text-secondary)] hover:text-[var(--color-text)]"
            >
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
              </svg>
              GitHub
            </a>
          </div>
        </Card>
      ))}
    </div>
  </Container>
</Section>
