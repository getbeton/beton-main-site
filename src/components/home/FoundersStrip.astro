---
import { getCollection } from 'astro:content';
import Container from '../ui/Container.astro';
import Section from '../ui/Section.astro';
import Heading from '../ui/Heading.astro';

// Surface only the two technical co-founders on the homepage. The full team
// page lists everyone; this strip is for E-E-A-T at the homepage level.
const team = await getCollection('team');
const featured = team
  .filter((m) => ['Vlad Nadymov', 'Aleks Markelov'].includes(m.data.name))
  .sort((a, b) => a.data.order - b.data.order);
---

<Section id="founders">
  <Container>
    <div class="text-center mb-8 lg:mb-10">
      <Heading as="h2">Built by founders who lived this problem</Heading>
      <p class="mt-3 text-base text-[var(--color-text-secondary)] max-w-2xl mx-auto">
        Vlad and Aleks worked together at Handl.ai (YC) before starting Beton.
      </p>
    </div>

    <div class="grid sm:grid-cols-2 gap-6 max-w-3xl mx-auto">
      {featured.map((member) => (
        <a
          href="/team/"
          class="flex items-start gap-4 p-5 border-2 border-[var(--color-text)] bg-[var(--color-surface)] shadow-[var(--shadow-card)] hover:shadow-[6px_6px_0_var(--color-text)] hover:-translate-x-0.5 hover:-translate-y-0.5"
        >
          {member.data.photo ? (
            <img
              src={member.data.photo}
              alt={member.data.name}
              width="64"
              height="64"
              class="w-16 h-16 rounded-full object-cover shrink-0 border-2 border-[var(--color-text)]"
            />
          ) : (
            <div class="w-16 h-16 rounded-full bg-[var(--color-primary-bg)] border-2 border-[var(--color-text)] flex items-center justify-center shrink-0">
              <span class="text-lg font-bold font-[family-name:var(--font-heading)] text-[var(--color-primary-600)]">
                {member.data.name.split(' ').map((n) => n[0]).join('')}
              </span>
            </div>
          )}
          <div class="min-w-0">
            <h3 class="font-semibold text-[var(--color-text)]">{member.data.name}</h3>
            <p class="text-xs uppercase tracking-wider text-[var(--color-text-secondary)] font-bold mb-2">{member.data.role}</p>
            <p class="text-sm text-[var(--color-text-secondary)] leading-relaxed">{member.data.bio}</p>
            {member.data.social?.linkedin && (
              <span class="mt-2 inline-block text-xs text-[var(--color-primary-600)] font-mono">LinkedIn →</span>
            )}
          </div>
        </a>
      ))}
    </div>
  </Container>
</Section>
