---
// Author card rendered above the article header on every blog post.
// Looks up the author by name in the 'team' collection so all data
// (photo, email, social, booking URL, slug) flows from one source of truth.
// If the author doesn't exist in the team collection, the card silently
// renders nothing — falling back to the existing byline in the header.

import { getCollection } from 'astro:content';

interface Props {
  author: string;
}

const { author } = Astro.props;

const team = await getCollection('team');
const member = team.find((m) => m.data.name === author);

const initials = author
  .split(/\s+/)
  .map((p) => p[0])
  .filter(Boolean)
  .slice(0, 2)
  .join('')
  .toUpperCase();

const slug = member?.id ?? author.toLowerCase().replace(/\s+/g, '-');
const data = member?.data;
---

{data && (
  <aside
    class="author-card not-prose flex items-start gap-4 sm:gap-5 p-4 sm:p-5 border-2 border-[var(--color-border)] bg-[var(--color-surface-raised)] shadow-[var(--shadow-card)]"
    aria-label={`Author: ${data.name}`}
  >
    <a
      href={`/team/${slug}/`}
      class="block shrink-0"
      aria-label={`${data.name} bio`}
    >
      {data.photo ? (
        <img
          src={data.photo}
          alt={data.name}
          width="64"
          height="64"
          class="w-14 h-14 sm:w-16 sm:h-16 object-cover border-2 border-[var(--color-border)] bg-[var(--color-surface)]"
        />
      ) : (
        <span
          class="flex items-center justify-center w-14 h-14 sm:w-16 sm:h-16 border-2 border-[var(--color-border)] bg-[var(--color-primary-600)] text-white font-bold text-xl sm:text-2xl font-[family-name:'JetBrains_Mono',ui-monospace,monospace] tracking-[-0.02em]"
          aria-hidden="true"
        >
          {initials}
        </span>
      )}
    </a>

    <div class="flex-1 min-w-0">
      <div class="flex flex-wrap items-baseline gap-x-2 gap-y-0.5">
        <a
          href={`/team/${slug}/`}
          class="text-base sm:text-lg font-bold text-[var(--color-text)] hover:text-[var(--color-primary-600)] hover:underline underline-offset-2"
        >
          {data.name}
        </a>
        <span class="text-sm text-[var(--color-text-secondary)]">
          &middot; {data.role}
        </span>
      </div>

      <div class="mt-1.5 flex flex-wrap items-center gap-x-3 gap-y-1 text-sm">
        {data.email && (
          <a
            href={`mailto:${data.email}`}
            class="text-[var(--color-text-secondary)] hover:text-[var(--color-primary-600)] hover:underline underline-offset-2"
            aria-label={`Email ${data.name}`}
          >
            {data.email}
          </a>
        )}

        {data.social?.linkedin && (
          <a
            href={data.social.linkedin}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1 text-[var(--color-text-secondary)] hover:text-[var(--color-primary-600)]"
            aria-label={`${data.name} on LinkedIn`}
          >
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M20.45 20.45h-3.55v-5.57c0-1.33-.03-3.04-1.85-3.04-1.86 0-2.14 1.45-2.14 2.95v5.66H9.36V9h3.41v1.56h.05a3.73 3.73 0 0 1 3.36-1.84c3.6 0 4.27 2.37 4.27 5.45v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.8 0 0 .78 0 1.73v20.54C0 23.22.8 24 1.77 24h20.45c.97 0 1.78-.78 1.78-1.73V1.73C24 .78 23.2 0 22.22 0z"/>
            </svg>
            <span>LinkedIn</span>
          </a>
        )}

        {data.social?.twitter && (
          <a
            href={data.social.twitter}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1 text-[var(--color-text-secondary)] hover:text-[var(--color-primary-600)]"
            aria-label={`${data.name} on X / Twitter`}
          >
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117L17.083 19.77z"/>
            </svg>
            <span>X</span>
          </a>
        )}

        {data.social?.github && (
          <a
            href={data.social.github}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1 text-[var(--color-text-secondary)] hover:text-[var(--color-primary-600)]"
            aria-label={`${data.name} on GitHub`}
          >
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
            </svg>
            <span>GitHub</span>
          </a>
        )}

        {data.bookingUrl && (
          <a
            href={data.bookingUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="text-[var(--color-primary-600)] font-bold underline decoration-2 underline-offset-2 hover:decoration-[3px]"
            data-track-cta="author-card-book-call"
          >
            Book a call
          </a>
        )}
      </div>
    </div>
  </aside>
)}
