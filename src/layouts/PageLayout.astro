---
import BaseLayout from './BaseLayout.astro';
import SkipLink from '../components/global/SkipLink.astro';
import Header from '../components/global/Header.astro';
import MobileMenu from '../components/global/MobileMenu.astro';
import Footer from '../components/global/Footer.astro';


interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  canonicalPath?: string;
  noIndex?: boolean;
  type?: 'website' | 'article';
  schemaType?: string;
  faqData?: { question: string; answer: string }[];
  breadcrumbs?: { name: string; url: string }[];
  reviewData?: { name: string; role?: string; company?: string; quote: string }[];
  personData?: { name: string; role: string; bio?: string; social?: { twitter?: string; linkedin?: string; github?: string } }[];
  itemList?: { name: string; items: { name: string; url: string; description?: string }[] };
  howToData?: { name: string; description: string; steps: { name: string; text: string }[] };
  datasetData?: { name: string; description: string; keywords?: string[]; license?: string; creator?: string; variableMeasured?: string[] };
  profilePage?: boolean;
  speakableSelectors?: string[];
}

const { title, description, ogImage, canonicalPath, noIndex, type, schemaType, faqData, breadcrumbs, reviewData, personData, itemList, howToData, datasetData, profilePage, speakableSelectors } = Astro.props;
---

<BaseLayout
  title={title}
  description={description}
  ogImage={ogImage}
  canonicalPath={canonicalPath}
  noIndex={noIndex}
  type={type}
  schemaType={schemaType}
  faqData={faqData}
  breadcrumbs={breadcrumbs}
  reviewData={reviewData}
  personData={personData}
  itemList={itemList}
  howToData={howToData}
  datasetData={datasetData}
  profilePage={profilePage}
  speakableSelectors={speakableSelectors}
>
  <SkipLink />
  <Header />
  <MobileMenu />
  <main id="main-content" class="flex-1">
    <slot />
    <slot name="sections" />
  </main>
  <Footer />
</BaseLayout>
