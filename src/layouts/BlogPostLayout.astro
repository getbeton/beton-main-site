---
import PageLayout from './PageLayout.astro';
import Container from '../components/ui/Container.astro';
import NewsletterSignup from '../components/blog/NewsletterSignup.astro';
import { SITE } from '../utils/site';

interface RelatedPost {
  slug: string;
  title: string;
  description: string;
  publishedAt: string;
  coverImage?: string;
  tags: string[];
}

interface Props {
  title: string;
  description: string;
  publishedAt: string;
  updatedAt?: string;
  author: string;
  tags: string[];
  coverImage?: string;
  slug: string;
  seo?: {
    metaTitle?: string;
    metaDescription?: string;
    ogImage?: string;
  };
  relatedPosts?: RelatedPost[];
}

const { title, description, publishedAt, updatedAt, author, tags, coverImage, slug, seo, relatedPosts = [] } = Astro.props;

const formattedDate = new Date(publishedAt).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const updatedDate = updatedAt
  ? new Date(updatedAt).toLocaleDateString('en-US', {
      year: 'numeric',
      month: 'long',
      day: 'numeric',
    })
  : null;

const readingTime = Math.ceil(
  (Astro.slots.has('default') ? 1000 : 200) / 200
);

const breadcrumbs = [
  { name: 'Home', url: SITE.url },
  { name: 'Blog', url: `${SITE.url}/blog/` },
  { name: title, url: `${SITE.url}/blog/${slug}/` },
];

const articleData = {
  title,
  description,
  author,
  publishedAt,
  updatedAt,
  tags,
  coverImage,
  url: `${SITE.url}/blog/${slug}/`,
};
---

<PageLayout
  title={seo?.metaTitle || title}
  description={seo?.metaDescription || description}
  ogImage={seo?.ogImage || coverImage}
  canonicalPath={`/blog/${slug}`}
  type="article"
  breadcrumbs={breadcrumbs}
>
  <article class="py-14 lg:py-20">
    <Container>
      <div class="max-w-3xl mx-auto">
        <!-- Header -->
        <header class="mb-10">
          <div class="flex flex-wrap items-center gap-2 mb-4">
            {tags.map((tag) => (
              <span class="inline-flex items-center px-2.5 py-0.5 text-xs font-medium tracking-wide uppercase border-2 border-[var(--color-border)] bg-[var(--color-surface-raised)]">
                {tag}
              </span>
            ))}
          </div>

          <h1 class="text-3xl lg:text-4xl font-bold tracking-tight mb-4">
            {title}
          </h1>

          <p class="text-lg text-[var(--color-text-secondary)] mb-6">
            {description}
          </p>

          <div class="flex items-center gap-4 text-sm text-[var(--color-text-tertiary)] border-t-2 border-b-2 border-[var(--color-border)] py-3">
            <span class="font-medium text-[var(--color-text-secondary)]">{author}</span>
            <span aria-hidden="true">&middot;</span>
            <time datetime={publishedAt}>{formattedDate}</time>
            {updatedDate && (
              <>
                <span aria-hidden="true">&middot;</span>
                <span>Updated {updatedDate}</span>
              </>
            )}
          </div>
        </header>

        {coverImage && (
          <div class="mb-10 -mx-4 lg:-mx-8 border-2 border-[var(--color-border)] overflow-hidden">
            <img
              src={coverImage}
              alt={title}
              width="896"
              height="448"
              class="w-full h-auto"
            />
          </div>
        )}

        <!-- Content -->
        <div class="prose">
          <slot />
        </div>

        <!-- Explore Beton -->
        <aside class="mt-14 pt-8 border-t-2 border-[var(--color-border)]" aria-label="Explore Beton">
          <h2 class="text-lg font-bold mb-3">Explore Beton</h2>
          <p class="text-sm text-[var(--color-text-secondary)] mb-4">
            Beton is open-source revenue intelligence — we detect behavioural signals in product usage data and route them to your CRM.
          </p>
          <ul class="flex flex-wrap gap-x-4 gap-y-2 text-sm">
            <li>
              <a href="/pricing/" class="text-[var(--color-primary-600)] font-medium hover:underline">Pricing &amp; plans</a>
            </li>
            <li>
              <a href="/integrations/posthog/" class="text-[var(--color-primary-600)] font-medium hover:underline">PostHog integration</a>
            </li>
            <li>
              <a href="/integrations/attio/" class="text-[var(--color-primary-600)] font-medium hover:underline">Attio integration</a>
            </li>
            <li>
              <a href="/integrations/" class="text-[var(--color-primary-600)] font-medium hover:underline">All integrations</a>
            </li>
            <li>
              <a href="https://github.com/getbeton/inspector" class="text-[var(--color-primary-600)] font-medium hover:underline" rel="noopener">Self-host on GitHub</a>
            </li>
          </ul>
        </aside>

        <!-- Footer -->
        <footer class="mt-10 pt-8 border-t-2 border-[var(--color-border)]">
          <NewsletterSignup id="post-newsletter" />

          <div class="mt-8 text-center">
            <a
              href="/blog/"
              class="inline-flex items-center gap-2 text-sm font-medium text-[var(--color-primary-600)] hover:underline"
            >
              &larr; Back to all posts
            </a>
          </div>
        </footer>
      </div>
    </Container>
  </article>

  {relatedPosts.length > 0 && (
    <section class="py-14 lg:py-20 bg-[var(--color-surface-raised)] border-t-2 border-[var(--color-border)]" aria-label="Related posts">
      <Container>
        <div class="max-w-5xl mx-auto">
          <h2 class="text-2xl lg:text-3xl font-[family-name:var(--font-heading)] tracking-wide mb-8 text-center">
            Keep reading
          </h2>
          <div class="grid md:grid-cols-3 gap-6">
            {relatedPosts.map((post) => (
              <a
                href={`/blog/${post.slug}/`}
                class="group flex flex-col border-2 border-[var(--color-border)] bg-[var(--color-surface)] shadow-[var(--shadow-card)] hover:shadow-[6px_6px_0_var(--color-text)] hover:-translate-x-0.5 hover:-translate-y-0.5 transition-all"
              >
                {post.coverImage && (
                  <div class="aspect-[16/9] border-b-2 border-[var(--color-border)] overflow-hidden">
                    <img
                      src={post.coverImage}
                      alt={post.title}
                      width="640"
                      height="360"
                      loading="lazy"
                      class="w-full h-full object-cover"
                    />
                  </div>
                )}
                <div class="p-5 flex-1 flex flex-col">
                  <time datetime={post.publishedAt} class="text-xs text-[var(--color-text-tertiary)] uppercase tracking-wider mb-2">
                    {new Date(post.publishedAt).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}
                  </time>
                  <h3 class="text-base font-semibold mb-2 group-hover:text-[var(--color-primary-600)]">
                    {post.title}
                  </h3>
                  <p class="text-sm text-[var(--color-text-secondary)] leading-relaxed line-clamp-3">
                    {post.description}
                  </p>
                </div>
              </a>
            ))}
          </div>
        </div>
      </Container>
    </section>
  )}

  <!-- Article JSON-LD -->
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: title,
    description,
    author: {
      '@type': 'Person',
      name: author,
    },
    publisher: {
      '@type': 'Organization',
      name: SITE.name,
      url: SITE.url,
      logo: `${SITE.url}/images/beton-logo.svg`,
    },
    datePublished: publishedAt,
    ...(updatedAt && { dateModified: updatedAt }),
    mainEntityOfPage: articleData.url,
    ...(coverImage && { image: coverImage.startsWith('http') ? coverImage : `${SITE.url}${coverImage}` }),
    keywords: tags.join(', '),
  })} />

</PageLayout>
